    {
      "type": "header",
      "content": "Discount code style"
    },
    {
      "type": "color",
      "id": "code_background_color",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "code_text_color",
      "label": "Text",
      "default": "#000000"
