{% doc %}
  @prompt
    add a discount home page popup, you need to make sure it appears infront of everything else on the page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-discount-popup-{{ ai_gen_id }} {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-discount-popup-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-discount-popup-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    cursor: pointer;
    z-index: 1;
  }

  .ai-discount-popup-container-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    max-width: {{ block.settings.popup_width }}px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    z-index: 2;
  }

  .ai-discount-popup-content-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px;
    text-align: {{ block.settings.text_alignment }};
    position: relative;
  }

  .ai-discount-popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.padding | divided_by: 2 }}px;
    right: {{ block.settings.padding | divided_by: 2 }}px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    transition: opacity 0.2s ease;
    z-index: 1;
  }

  .ai-discount-popup-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-discount-popup-close-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-discount-popup-image-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-discount-popup-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-discount-popup-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-discount-popup-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 24px;
    line-height: 1.5;
  }

  .ai-discount-popup-code-{{ ai_gen_id }} {
    background-color: {{ block.settings.code_background_color }};
    color: {{ block.settings.code_text_color }};
    padding: 16px 24px;
    border-radius: {{ block.settings.code_border_radius }}px;
    font-size: {{ block.settings.code_size }}px;
    font-weight: 600;
    letter-spacing: 2px;
    margin: 0 0 24px;
    display: inline-block;
    border: 2px dashed {{ block.settings.code_border_color }};
  }

  .ai-discount-popup-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease, transform 0.2s ease;
    cursor: pointer;
    border: none;
  }

  .ai-discount-popup-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-discount-popup-container-{{ ai_gen_id }} {
      max-width: 95%;
    }

    .ai-discount-popup-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-discount-popup-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-discount-popup-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-discount-popup-code-{{ ai_gen_id }} {
      font-size: {{ block.settings.code_size | times: 0.9 }}px;
      padding: 12px 20px;
    }
  }
{% endstyle %}

<discount-popup-{{ ai_gen_id }}
  class="ai-discount-popup-{{ ai_gen_id }}"
  data-delay="{{ block.settings.delay_seconds }}"
  data-show-once="{{ block.settings.show_once }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-discount-popup-overlay-{{ ai_gen_id }}"></div>
  <div class="ai-discount-popup-container-{{ ai_gen_id }}">
    <div class="ai-discount-popup-content-{{ ai_gen_id }}">
      <button
        class="ai-discount-popup-close-{{ ai_gen_id }}"
        aria-label="Close popup"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      {% if block.settings.image %}
        <div class="ai-discount-popup-image-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-discount-popup-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-discount-popup-text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.discount_code != blank %}
        <div class="ai-discount-popup-code-{{ ai_gen_id }}">
          {{ block.settings.discount_code }}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-discount-popup-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</discount-popup-{{ ai_gen_id }}>

<script>
  (function() {
    class DiscountPopup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.delay = parseInt(this.dataset.delay) * 1000;
        this.showOnce = this.dataset.showOnce === 'true';
        this.storageKey = 'ai-discount-popup-{{ ai_gen_id }}-shown';
      }

      connectedCallback() {
        this.overlay = this.querySelector('.ai-discount-popup-overlay-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-discount-popup-close-{{ ai_gen_id }}');
        this.button = this.querySelector('.ai-discount-popup-button-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.checkAndShowPopup();
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => this.closePopup());
        this.overlay.addEventListener('click', () => this.closePopup());

        if (this.button) {
          this.button.addEventListener('click', () => this.closePopup());
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.classList.contains('active')) {
            this.closePopup();
          }
        });
      }

      checkAndShowPopup() {
        if (this.showOnce && localStorage.getItem(this.storageKey)) {
          return;
        }

        setTimeout(() => {
          this.showPopup();
        }, this.delay);
      }

      showPopup() {
        this.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closePopup() {
        this.classList.remove('active');
        document.body.style.overflow = '';

        if (this.showOnce) {
          localStorage.setItem(this.storageKey, 'true');
        }
      }
    }

    customElements.define('discount-popup-{{ ai_gen_id }}', DiscountPopup{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Discount popup",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Get 15% Off Your First Order!"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Subscribe to our newsletter and enjoy exclusive discounts on your first purchase."
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "default": "WELCOME15"
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Popup settings"
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay before showing",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_once",
      "label": "Show only once per visitor",
