{%- liquid
  assign block_settings = block.settings
  assign product = closest.product

  assign mto_tag_down = block_settings.made_to_order_tag | default: 'made-to-order' | downcase | strip
  assign is_made_to_order = false
  for product_tag in product.tags
    assign product_tag_down = product_tag | downcase | strip
    if product_tag_down == mto_tag_down
      assign is_made_to_order = true
      break
    endif
  endfor

  if is_made_to_order
    assign message = block_settings.made_to_order_text
    assign state_class = 'delivery-message--made-to-order'
  else
    assign message = block_settings.in_stock_text
    assign state_class = 'delivery-message--in-stock'
  endif
-%}
{%- if message != blank -%}
  <div
    class="delivery-message spacing-style {{ state_class }}{% if block_settings.type_preset != '' %} {{ block_settings.type_preset }}{% endif %}"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.show_indicator -%}
      <span class="delivery-message__dot" aria-hidden="true"></span>
    {%- endif -%}
    <span class="delivery-message__text">{{ message }}</span>
  </div>
{%- endif -%}

{% stylesheet %}
  .delivery-message {
    display: flex;
    align-items: center;
    gap: var(--padding-xs);
    color: var(--color-foreground);
  }

  .delivery-message__dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-foreground);
  }

  .delivery-message--in-stock .delivery-message__dot {
    background-color: var(--color-instock, currentColor);
  }

  .delivery-message--made-to-order .delivery-message__dot {
    background-color: var(--color-lowstock, currentColor);
  }

  .delivery-message__text {
    line-height: var(--font-paragraph--line-height);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Delivery message",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a delivery estimate on the product page. Products carrying the made-to-order tag show the made-to-order message; all others show the in-stock message."
    },
    {
      "type": "text",
      "id": "in_stock_text",
      "label": "In-stock message",
      "default": "In stock · Ships within 24 hours"
    },
    {
      "type": "text",
      "id": "made_to_order_text",
      "label": "Made-to-order message",
      "default": "Made to order · Ships in 9–16 days"
    },
    {
      "type": "text",
      "id": "made_to_order_tag",
      "label": "Made-to-order tag",
      "info": "Products with this tag show the made-to-order message.",
      "default": "made-to-order"
    },
    {
      "type": "checkbox",
      "id": "show_indicator",
      "label": "Show status dot",
      "default": true
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Text size",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "caption", "label": "Small" },
        { "value": "paragraph", "label": "Medium" },
        { "value": "h6", "label": "Large" }
      ],
      "default": "paragraph"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Delivery message",
      "category": "Product"
    }
  ]
}
{% endschema %}
