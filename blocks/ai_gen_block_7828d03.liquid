{% doc %}
  @prompt
    Update the existing discount popup block (section ID: template--29113519505751__1774366126d3ec9b5b, block ID: template--29113519505751__1774366126d3ec9b5b__ai_gen_block_92d7d51_fH9j4U) with these three changes: 1) Fix the z-index layering issue so the popup appears above absolutely everything including the site header and sticky navigation — set z-index to 2147483647 (maximum possible) on both the overlay and the popup modal itself, and ensure it uses fixed positioning. Also check if the header has a high z-index and make sure the popup exceeds it. 2) Add click-to-copy functionality on the discount code text — when a user clicks the discount code, it copies to their clipboard and shows a brief "Copied!" confirmation message. 3) Change the border to a chromatic silver holographic effect — an animated shimmering silver/chrome border that cycles through silver, white, light grey, and subtle rainbow prismatic tones, like a holographic foil or chrome finish, using CSS gradient animation.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-discount-popup-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 2147483647;
  }

  .ai-discount-popup-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-discount-popup-modal-{{ ai_gen_id }} {
    position: fixed;
    background-color: {{ block.settings.popup_background_color }};
    padding: 40px;
    max-width: 500px;
    width: 90%;
    text-align: center;
    transform: scale(0.8);
    transition: transform 0.3s ease;
    z-index: 2147483647;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-discount-popup-overlay-{{ ai_gen_id }}.active .ai-discount-popup-modal-{{ ai_gen_id }} {
    transform: scale(1);
  }

  .ai-discount-popup-modal-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.border_width }}px;
    background: linear-gradient(
      45deg,
      #c0c0c0,
      #ffffff,
      #e8e8e8,
      #d4d4d4,
      #ffffff,
      #c0c0c0,
      #ff00ff10,
      #00ffff10,
      #ffff0010,
      #c0c0c0,
      #ffffff
    );
    background-size: 400% 400%;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: ai-holographic-border-{{ ai_gen_id }} 3s ease infinite;
    pointer-events: none;
  }

  @keyframes ai-holographic-border-{{ ai_gen_id }} {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .ai-discount-popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: {{ block.settings.text_color }};
    line-height: 1;
    padding: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-discount-popup-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-discount-popup-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 15px;
  }

  .ai-discount-popup-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 25px;
  }

  .ai-discount-popup-code-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: inline-block;
    margin-bottom: 20px;
  }

  .ai-discount-popup-code-{{ ai_gen_id }} {
    background-color: {{ block.settings.code_background_color }};
    color: {{ block.settings.code_text_color }};
    padding: 15px 30px;
    font-size: {{ block.settings.code_size }}px;
    font-weight: bold;
    border-radius: {{ block.settings.code_border_radius }}px;
    display: inline-block;
    letter-spacing: 2px;
    cursor: pointer;
    transition: transform 0.2s ease;
    user-select: all;
  }

  .ai-discount-popup-code-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
  }

  .ai-discount-popup-code-{{ ai_gen_id }}:active {
    transform: scale(0.98);
  }

  .ai-discount-popup-copied-{{ ai_gen_id }} {
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.heading_color }};
    color: {{ block.settings.popup_background_color }};
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .ai-discount-popup-copied-{{ ai_gen_id }}.show {
    opacity: 1;
  }

  .ai-discount-popup-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    padding: 15px 40px;
    font-size: {{ block.settings.button_size }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .ai-discount-popup-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-discount-popup-modal-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-discount-popup-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-discount-popup-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }

    .ai-discount-popup-code-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.code_size }}px * 0.85);
      padding: 12px 20px;
    }
  }
{% endstyle %}

<discount-popup-{{ ai_gen_id }} {{ block.shopify_attributes }}>
  <div class="ai-discount-popup-overlay-{{ ai_gen_id }}" data-popup-overlay>
    <div class="ai-discount-popup-modal-{{ ai_gen_id }}" data-popup-modal>
      <button class="ai-discount-popup-close-{{ ai_gen_id }}" data-close-popup aria-label="Close popup">
        ×
      </button>

      {% if block.settings.heading != blank %}
        <h2 class="ai-discount-popup-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-discount-popup-text-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      {% if block.settings.discount_code != blank %}
        <div class="ai-discount-popup-code-wrapper-{{ ai_gen_id }}">
          <div class="ai-discount-popup-copied-{{ ai_gen_id }}" data-copied-message>Copied!</div>
          <div class="ai-discount-popup-code-{{ ai_gen_id }}" data-discount-code>
            {{ block.settings.discount_code }}
          </div>
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-discount-popup-button-{{ ai_gen_id }}" data-shop-button>
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</discount-popup-{{ ai_gen_id }}>

<script>
  (function() {
    class DiscountPopup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.overlay = this.querySelector('[data-popup-overlay]');
        this.modal = this.querySelector('[data-popup-modal]');
        this.closeButton = this.querySelector('[data-close-popup]');
        this.discountCode = this.querySelector('[data-discount-code]');
        this.copiedMessage = this.querySelector('[data-copied-message]');
        this.shopButton = this.querySelector('[data-shop-button]');
        this.delay = {{ block.settings.popup_delay }} * 1000;
        this.hasShown = false;
      }

      connectedCallback() {
        this.checkAndShowPopup();
        this.setupEventListeners();
      }

      checkAndShowPopup() {
        const popupShown = sessionStorage.getItem('discountPopupShown{{ ai_gen_id }}');
        
        if (!popupShown) {
          setTimeout(() => {
            this.showPopup();
          }, this.delay);
        }
      }

      showPopup() {
        this.overlay.classList.add('active');
        this.hasShown = true;
        sessionStorage.setItem('discountPopupShown{{ ai_gen_id }}', 'true');
      }

      hidePopup() {
        this.overlay.classList.remove('active');
      }

      copyToClipboard(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(() => {
            this.showCopiedMessage();
          }).catch(() => {
            this.fallbackCopy(text);
          });
        } else {
          this.fallbackCopy(text);
        }
      }

      fallbackCopy(text) {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        document.body.appendChild(textArea);
        textArea.select();
        try {
          document.execCommand('copy');
          this.showCopiedMessage();
        } catch (err) {
          console.error('Failed to copy text');
        }
        document.body.removeChild(textArea);
      }

      showCopiedMessage() {
        this.copiedMessage.classList.add('show');
        setTimeout(() => {
          this.copiedMessage.classList.remove('show');
        }, 2000);
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => {
          this.hidePopup();
        });

        this.overlay.addEventListener('click', (e) => {
          if (e.target === this.overlay) {
            this.hidePopup();
          }
        });

        if (this.discountCode) {
          this.discountCode.addEventListener('click', () => {
            const code = this.discountCode.textContent.trim();
            this.copyToClipboard(code);
          });
        }

        if (this.shopButton) {
          this.shopButton.addEventListener('click', () => {
            this.hidePopup();
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.overlay.classList.contains('active')) {
            this.hidePopup();
          }
        });
      }
    }

    customElements.define('discount-popup-{{ ai_gen_id }}', DiscountPopup{{ ai_gen_id }});
  })();
</script>

