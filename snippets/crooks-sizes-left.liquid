{%- comment -%}
  Per-size availability, in one place.

  product.available is true while a single variant remains, so a piece with
  three of five sizes gone still reads AVAILABLE. This works out how many size
  VALUES are actually buyable, so a card can say "2 OF 5 SIZES LEFT" instead.

  Counted per size value, not per variant: a tee is size x colour, so M is
  still available while only M/BLACK is gone. Scoped to an option actually
  named like a size, so the socks' "Quantity" and one-size pieces are left
  alone rather than told they have options left.

  It lived inside the catalogue section, which is why the related rail on the
  product page never learned it and went on calling half-sold pieces available.
  Shared here so the two cannot drift apart again.

  Params
    product          required
    sizes_left_label optional  "[n] OF [m] SIZES LEFT"
    low_threshold    optional  integer; 0 or absent disables low stock
    low_label        optional  shown when total stock is at or under threshold
    sold_label       optional  shown when nothing is buyable
    available_label  optional  the fallback when none of the above apply

    class            optional  class for the emitted span

  Outputs the status span, or nothing at all when there is nothing to say.
  It emits markup rather than setting variables because {% render %} has an
  isolated scope — anything assigned in here is invisible to the caller, so
  handing back a value is not on the table.

  The span carries data-crk-stock so a caller can colour the states from CSS
  without the snippet knowing anything about either caller's palette:
    sold  nothing buyable
    low   real inventory at or under the caller's threshold
    part  some sizes gone, some left
    ok    everything available
{%- endcomment -%}

{%- liquid
  assign crk_p = product

  comment
    Low stock from real inventory only — a threshold over the summed quantity of
    purchasable variants. No invented scarcity: if nothing is tracked the total
    is 0 and the piece simply reads as available.
  endcomment
  assign crk_low = false
  assign crk_low_t = low_threshold | default: 0
  if crk_low_t > 0 and crk_p.available
    assign crk_qty = 0
    for v in crk_p.variants
      if v.available
        assign crk_qty = crk_qty | plus: v.inventory_quantity
      endif
    endfor
    if crk_qty > 0 and crk_qty <= crk_low_t
      assign crk_low = true
    endif
  endif

  assign crk_size_pos = 0
  assign crk_size_vals = null
  for opt in crk_p.options_with_values
    assign crk_opt_name = opt.name | downcase
    if crk_opt_name contains 'size'
      assign crk_size_pos = forloop.index
      assign crk_size_vals = opt.values
      break
    endif
  endfor

  assign crk_sizes_total = 0
  assign crk_sizes_left = 0
  if crk_size_vals and crk_p.available
    assign crk_sizes_total = crk_size_vals.size
    for val in crk_size_vals
      assign crk_val_ok = false
      for v in crk_p.variants
        unless v.available
          continue
        endunless
        if crk_size_pos == 1
          assign crk_vv = v.option1
        elsif crk_size_pos == 2
          assign crk_vv = v.option2
        else
          assign crk_vv = v.option3
        endif
        if crk_vv == val
          assign crk_val_ok = true
          break
        endif
      endfor
      if crk_val_ok
        assign crk_sizes_left = crk_sizes_left | plus: 1
      endif
    endfor
  endif

  assign crk_sizes_partial = false
  if crk_sizes_total > 1 and crk_sizes_left > 0 and crk_sizes_left < crk_sizes_total
    assign crk_sizes_partial = true
  endif

  comment
    Formatted here, not in an output tag: chaining filters inside {{ }} is the
    precedence trap this codebase has hit four times.
  endcomment
  assign crk_sizes_line = ''
  if crk_sizes_partial and sizes_left_label != blank
    assign crk_sizes_line = sizes_left_label | replace: '[n]', crk_sizes_left
    assign crk_sizes_line = crk_sizes_line | replace: '[m]', crk_sizes_total
  endif

  assign crk_sizes_status = ''
  assign crk_state = 'ok'
  if crk_p.available == false
    assign crk_sizes_status = sold_label
    assign crk_state = 'sold'
  elsif crk_low
    assign crk_sizes_status = low_label
    assign crk_state = 'low'
  elsif crk_sizes_line != blank
    assign crk_sizes_status = crk_sizes_line
    assign crk_state = 'part'
  else
    assign crk_sizes_status = available_label
  endif
-%}
{%- if crk_sizes_status != blank -%}
  <span class="{{ class }}" data-crk-stock="{{ crk_state }}">{{ crk_sizes_status }}</span>
{%- endif -%}
