{%- comment -%}
  "Complete the set" toggle — inside the purchase panel, between the dispatch
  line and ADD TO BAG.

  Data-driven, never hardcoded. A product joins a set by carrying four
  metafields; no product handle appears anywhere in this file:
    crooks.set_partner        the other garment (product reference)
    crooks.set_bundle         the bundle product that sells both (product ref)
    crooks.set_partner_option the name of the bundle option holding the
                              PARTNER's size — stated explicitly so the theme
                              never guesses which of the bundle's two size
                              options belongs to which garment
    crooks.set_short_name     how a product is named in its partner's copy

  Wiring: the bundle product carries one variant per size PAIR (5 x 5 = 25),
  each mapping to the two component variants, so inventory and fulfilment track
  per component. Ticking the box swaps the form's variant id to the matching
  bundle variant; unticking restores the single item. One add to cart, one line.

  Every price below is rendered through `money` in Liquid, so it follows the
  shopper's presentment currency — no currency string is ever assembled in JS.

  All copy is a section setting. No concept vocabulary on this element.
{%- endcomment -%}

{%- liquid
  assign crk_partner = product.metafields.crooks.set_partner.value
  assign crk_bundle = product.metafields.crooks.set_bundle.value
  assign crk_partner_option = product.metafields.crooks.set_partner_option.value
  assign crk_set_ok = false
  if crk_partner and crk_bundle and crk_partner_option != blank and crk_bundle.available
    assign crk_set_ok = true
  endif

  comment
    Position of the partner's size within the bundle's options, read from the
    metafield rather than inferred from option names. Zero means set_partner_option
    does not name any option on the bundle — a typo, or an option renamed in
    admin. Rather than render a toggle that quietly pairs the wrong sizes, the
    whole panel stands down and the page sells the single garment.
  endcomment
  assign crk_partner_pos = 0
  if crk_set_ok
    for opt in crk_bundle.options_with_values
      if opt.name == crk_partner_option
        assign crk_partner_pos = forloop.index
        break
      endif
    endfor
    if crk_partner_pos == 0
      assign crk_set_ok = false
    endif
  endif
-%}

{%- if crk_set_ok -%}
  {%- liquid
    assign crk_partner_name = crk_partner.metafields.crooks.set_short_name.value | default: crk_partner.title
  -%}

  <div
    class="crk-set"
    data-crk-set
    data-crk-set-cta="{{ section.settings.set_cta | escape }}"
    data-crk-set-sold="{{ section.settings.set_sold_text | replace: '[partner]', crk_partner_name | escape }}"
    data-crk-set-pick="{{ section.settings.set_pick_text | replace: '[partner]', crk_partner_name | escape }}"
    data-crk-set-main-first="{{ section.settings.set_main_first_text | escape }}"
    data-crk-set-components="{% for v in product.variants %}{{ v.id }},{% endfor %}{% for v in crk_partner.variants %}{{ v.id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
  >
    <label class="crk-set__row" for="crk-set-toggle">
      <input class="crk-check" id="crk-set-toggle" type="checkbox" data-crk-set-check>
      {%- if crk_partner.featured_image -%}
        {{
          crk_partner.featured_image
          | image_url: width: 96
          | image_tag: widths: '48, 96', alt: '', loading: 'lazy', class: 'crk-set__thumb'
        }}
      {%- endif -%}
      <span class="crk-set__copy">
        {%- liquid
          assign crk_pair = product.price | plus: crk_partner.price
          assign crk_saving_money = crk_pair | minus: crk_bundle.price | money_without_trailing_zeros
          assign crk_line = section.settings.set_collapsed_text | replace: '[partner]', crk_partner_name
          assign crk_line = crk_line | replace: '[saving]', crk_saving_money
        -%}
        {{ crk_line }}
      </span>
    </label>

    <div class="crk-set__panel" data-crk-set-panel hidden>
      <p class="crk-eyebrow crk-set__label" id="crk-set-size-label">
        {{ section.settings.set_partner_size_label | replace: '[partner]', crk_partner_name }}
      </p>
      {%- comment -%}
        Every size renders unselected. The second garment is a second decision:
        matching it to the first is a guess, and a guess rendered as a chosen
        button is indistinguishable from the shopper's own choice.
      {%- endcomment -%}
      <div class="crk-sizes crk-set__sizes" role="group" aria-labelledby="crk-set-size-label" data-crk-set-sizes>
        {%- for opt in crk_partner.options_with_values -%}
          {%- assign crk_opt_name = opt.name | downcase -%}
          {%- if crk_opt_name contains 'size' -%}
            {%- for val in opt.values -%}
              <button
                type="button"
                class="crk-size"
                data-crk-set-size="{{ val | escape }}"
                aria-pressed="false"
              >{{ val }}</button>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="crk-stockline crk-set__stock" data-crk-set-stock aria-live="polite"></p>

      <p class="crk-set__price">
        <s class="crk-set__was" data-crk-set-was></s>
        <span class="crk-set__now" data-crk-set-now></span>
      </p>

      {%- if section.settings.set_shipping_text != blank -%}
        <p class="crk-micro crk-set__ship">{{ section.settings.set_shipping_text }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}
      The bundle's variants, one per size pair, with prices already formatted by
      Liquid. JS only reads and swaps these strings.
    {%- endcomment -%}
    <ul class="crk-sr" data-crk-set-variants aria-hidden="true">
      {%- for bv in crk_bundle.variants -%}
        {%- liquid
          comment
            Split the bundle variant into the partner's size and everything
            else. Written against bv.options rather than option1/option2
            because a bundle is not always two axes: the Pink hoodie carries
            a V1/V2 variant as well as a size, so its set has three options
            and the old pair of assignments read the variant letter as the
            partner's size.

            What is left over, joined in the bundle's own option order, is
            exactly the main product's variant title — "XS" for a one-option
            garment, "XS / V1" for two — which is what the match below and
            the JS both key on.
          endcomment
          assign crk_bv_partner = ''
          assign crk_bv_main = ''
          for crk_ov in bv.options
            if forloop.index == crk_partner_pos
              assign crk_bv_partner = crk_ov
            elsif crk_bv_main == ''
              assign crk_bv_main = crk_ov
            else
              assign crk_bv_main = crk_bv_main | append: ' / ' | append: crk_ov
            endif
          endfor

          assign crk_main_v = null
          for v in product.variants
            if v.title == crk_bv_main
              assign crk_main_v = v
              break
            endif
          endfor
          assign crk_partner_v = null
          for v in crk_partner.variants
            if v.title == crk_bv_partner
              assign crk_partner_v = v
              break
            endif
          endfor

          assign crk_was = 0
          if crk_main_v and crk_partner_v
            assign crk_was = crk_main_v.price | plus: crk_partner_v.price
          endif
          assign crk_was_money = crk_was | money_without_trailing_zeros
          assign crk_now_money = bv.price | money_without_trailing_zeros
          assign crk_cta_line = section.settings.set_cta | replace: '[price]', crk_now_money
          assign crk_now_line = section.settings.set_price_label | replace: '[price]', crk_now_money
        -%}
        <li
          data-id="{{ bv.id }}"
          data-main="{{ crk_bv_main | escape }}"
          data-partner="{{ crk_bv_partner | escape }}"
          data-available="{{ bv.available }}"
          data-was="{{ crk_was_money | escape }}"
          data-now="{{ crk_now_line | escape }}"
          data-cta="{{ crk_cta_line | escape }}"
        ></li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
