{{ 'crooks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'crooks-drawer.js' | asset_url }}" defer></script>
{%- if section.settings.show_case and section.settings.case_url != blank -%}
  <script src="{{ 'crooks-board.js' | asset_url }}" defer></script>
{%- endif -%}
<script src="{{ 'crooks-theme.js' | asset_url }}" defer></script>

{%- liquid
  assign crk_menu = linklists[section.settings.menu]
  assign crk_cart_count = cart.item_count
-%}

{%- comment -%}
  The uploaded mark is a black silhouette on transparency, so on the near-black
  ground it is invisible. The attribute drives a CSS invert in dark mode only.
  It is a setting because inverting a COLOUR logo would wreck it — anyone who
  uploads one turns this off rather than editing CSS.
{%- endcomment -%}
<header class="crk-root crk-header" data-crk-section="header"{% if section.settings.logo_invert_dark %} data-crk-logo-invert="true"{% endif %}>
  <div class="crk-header__bar">
    <a class="crk-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag: widths: '100, 200, 300, 400', alt: shop.name, loading: 'eager'
        }}
      {%- else -%}
        {{ section.settings.wordmark | default: shop.name }}
      {%- endif -%}
    </a>

    <div class="crk-header__actions">
      {%- comment -%}
        Catalogue sits first in the actions row, to the left of search: it is the
        main browse destination and the homepage CTA uses the same word. A link,
        not a menu item — the nav menu is merchant data and this is chrome.
      {%- endcomment -%}
      {%- if section.settings.show_catalogue and section.settings.catalogue_url != blank -%}
        <a class="crk-header__link crk-header__link--catalogue" href="{{ section.settings.catalogue_url }}">{{ section.settings.catalogue_label }}</a>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <a class="crk-header__link" href="{{ routes.search_url }}">{{ section.settings.search_label }}</a>
      {%- endif -%}

      {%- comment -%}
        Cart is never hidden behind the drawer — it is a sale-critical control.
      {%- endcomment -%}
      <a class="crk-header__link" href="{{ routes.cart_url }}">
        {{ section.settings.cart_label }}
        <span class="crk-header__count" data-crk-cart-count>&nbsp;[{{ crk_cart_count }}]</span>
      </a>

      {%- if section.settings.show_theme_toggle -%}
        {%- comment -%}
          Light/dark switch. Hidden until JS upgrades it so it is never a dead
          control; the label states what it will do, per the prototype.
        {%- endcomment -%}
        <button
          class="crk-header__link"
          type="button"
          hidden
          data-crk-theme-toggle
          data-crk-to-light="{{ section.settings.label_to_light | escape }}"
          data-crk-to-dark="{{ section.settings.label_to_dark | escape }}"
          aria-pressed="false"
        >{{ section.settings.label_to_light }}</button>
      {%- endif -%}

      {%- comment -%}
        Text trigger, not a hamburger. Hidden until JS upgrades it, so it can
        never be a dead control; the <noscript> menu below covers that case.
      {%- endcomment -%}
      <button
        class="crk-header__link"
        type="button"
        hidden
        data-crk-drawer-open
        data-crk-label-open="{{ section.settings.menu_label | escape }}"
        data-crk-label-close="{{ section.settings.close_label | escape }}"
        aria-controls="crk-drawer"
        aria-expanded="false"
      >{{ section.settings.menu_label }}</button>
    </div>
  </div>

  {%- comment -%} Without JS the drawer cannot open, so render the menu inline. {%- endcomment -%}
  <noscript>
    <div class="crk-header__nofallback">
      <ul>
        {%- for link in crk_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  </noscript>

  <div
    class="crk-drawer"
    id="crk-drawer"
    data-crk-drawer
    role="dialog"
    aria-modal="true"
    aria-label="{{ section.settings.drawer_label | escape }}"
    hidden
  >
    <div class="crk-drawer__scrim" data-crk-drawer-close></div>
    <div class="crk-drawer__panel">
      <div class="crk-drawer__head">
        <p class="crk-eyebrow">{{ section.settings.drawer_heading }}</p>
        <button class="crk-header__link" type="button" data-crk-drawer-close>
          {{ section.settings.close_label }}
        </button>
      </div>

      <nav class="crk-drawer__nav" aria-label="{{ section.settings.drawer_label | escape }}">
        <ul>
          {%- for link in crk_menu.links -%}
            <li class="crk-drawer__item">
              <a class="crk-drawer__link" href="{{ link.url }}">{{ link.title }}</a>
              {%- if link.links.size > 0 -%}
                <ul class="crk-drawer__sub">
                  {%- for child in link.links -%}
                    <li><a class="crk-drawer__link" href="{{ child.url }}">{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      {%- comment -%}
        CASE 001 lived in a full-width box on the homepage. Moved here: the
        drawer had dead space between the last menu item and the account/cart
        row, and a game promo is exactly the kind of thing that belongs in a
        menu rather than between the catalogue and the manifest.

        One anchor wraps the whole panel, so the CTA underneath is a styled
        span rather than a second interactive element inside a link.
      {%- endcomment -%}
      {%- if section.settings.show_case and section.settings.case_url != blank -%}
        <a
          class="crk-drawer__case"
          href="{{ section.settings.case_url }}"
          {% if section.settings.case_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          <span class="crk-drawer__case-art">
            <canvas class="crk-board crk-drawer__case-board" data-crk-board aria-hidden="true"></canvas>
          </span>
          <span class="crk-btn crk-btn--fill crk-drawer__case-cta">{{ section.settings.case_cta }}</span>
          <span class="crk-sr">{{ section.settings.case_caption }}</span>
        </a>
      {%- endif -%}

      <div class="crk-drawer__foot">
        {%- if shop.customer_accounts_enabled -%}
          <a class="crk-header__link" href="{{ routes.account_url }}">{{ section.settings.account_label }}</a>
        {%- endif -%}
        <a class="crk-header__link" href="{{ routes.cart_url }}">
          {{ section.settings.cart_label }}<span data-crk-cart-count>&nbsp;[{{ crk_cart_count }}]</span>
        </a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Crooks — Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the wordmark text below." },
    { "type": "checkbox", "id": "logo_invert_dark", "label": "Flip logo to light in dark mode", "info": "For a dark, single-colour logo on a transparent background. Turn off for a colour logo.", "default": true },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "CROOKSLDN" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "menu_label", "label": "Menu button (closed)", "default": "MENU" },
    { "type": "text", "id": "close_label", "label": "Menu button (open)", "default": "CLOSE" },
    { "type": "text", "id": "cart_label", "label": "Cart label", "default": "BAG" },
    { "type": "checkbox", "id": "show_catalogue", "label": "Show the catalogue link", "default": true },
    { "type": "text", "id": "catalogue_label", "label": "Catalogue label", "default": "CATALOGUE" },
    { "type": "url", "id": "catalogue_url", "label": "Catalogue link", "info": "Shopify rejects a shopify:// default on a url setting, so the value is set on the header group rather than here." },
    { "type": "text", "id": "search_label", "label": "Search label", "default": "SEARCH" },
    { "type": "text", "id": "account_label", "label": "Account label", "default": "ACCOUNT" },
    { "type": "text", "id": "drawer_heading", "label": "Drawer heading", "default": "INDEX" },
    { "type": "text", "id": "drawer_label", "label": "Drawer label (screen readers)", "default": "Main menu" },
    { "type": "header", "content": "Case 001 (menu drawer)" },
    { "type": "checkbox", "id": "show_case", "label": "Show the case panel in the menu", "default": true },
    { "type": "text", "id": "case_caption", "label": "Panel description (screen readers)", "default": "CASE 001: THE GETAWAY. Animated map: a thief moves through an alley grid collecting coins while a patrolling officer crosses below." },
    { "type": "text", "id": "case_cta", "label": "Button label", "default": "PLAY CASE:001 NOW" },
    { "type": "url", "id": "case_url", "label": "Case link" },
    { "type": "checkbox", "id": "case_new_tab", "label": "Open in a new tab", "default": true },
    { "type": "header", "content": "Options" },
    { "type": "checkbox", "id": "show_search", "label": "Show search link", "default": true },
    { "type": "checkbox", "id": "show_theme_toggle", "label": "Show light/dark toggle", "default": true },
    { "type": "text", "id": "label_to_light", "label": "Label when dark (switches to light)", "default": "LIGHT MODE" },
    { "type": "text", "id": "label_to_dark", "label": "Label when light (switches to dark)", "default": "DARK MODE" }
  ],
  "presets": [{ "name": "Crooks — Header" }]
}
{% endschema %}
