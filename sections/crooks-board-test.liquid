{% comment %}
  THROWAWAY — Phase 1 board harness. Delete before rollout.
  Its only job is to mount the CASE 001 attract board in a real theme context so the
  canvas can be checked at 1x/2x/3x DPR, offscreen-pause and reduced-motion.
{% endcomment %}
{{ 'crooks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'crooks-board.js' | asset_url }}" defer></script>

<section class="crk-root" data-crk-section="board-test">
  <div class="crk-inner">
    <figure class="crk-hero__board crk-board-panel" style="max-width: 560px; margin: 0 auto;">
      <p class="crk-micro">{{ section.settings.label_top }}</p>
      <div class="crk-board__frame">
        <canvas class="crk-board" data-crk-board aria-hidden="true"></canvas>
      </div>
      <p class="crk-micro">{{ section.settings.label_bottom }}</p>
      <figcaption class="crk-sr">{{ section.settings.sr_caption }}</figcaption>
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Crooks — Board Test",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label_top", "label": "Top micro-label", "default": "CASE 001 — ATTRACT MODE" },
    { "type": "text", "id": "label_bottom", "label": "Bottom micro-label", "default": "REF 001 / 13×11 / DECLASSIFIED" },
    { "type": "text", "id": "sr_caption", "label": "Screen-reader caption", "default": "Animated pixel map from CASE 001: a figure moves through an alley grid collecting three packages." }
  ],
  "presets": [{ "name": "Crooks — Board Test" }]
}
{% endschema %}
