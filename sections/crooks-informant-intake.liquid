{{ 'crooks.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  INFORMANT INTAKE — SMS first, email optional.

  Two ways to capture, and the panel supports both:

  1. APP BLOCK (preferred). Shopify Forms and Omnisend are both installed and
     enabled on this store, and either one writes a real customer record with
     real SMS marketing consent — which is what a merchant actually wants and
     what a Liquid form cannot do. Add one inside this section in the theme
     editor and it renders here, inside the terminal frame, in place of the
     fallback below.

  2. FALLBACK (no app block added). A `contact` form: the number reaches the
     store inbox and nothing is silently lost, but it creates no consent record
     and no customer. Better than nothing, worse than the app block.

  Note for anyone tempted to "simplify" this to {% form 'customer' %} with a
  phone field: that form is documented to take contact[email] only. It would
  subscribe the person to EMAIL and drop the number without an error.

  UK PECR requires prior consent for marketing texts, so the fallback's consent
  checkbox is required and the small print states frequency and how to stop.
{%- endcomment -%}

<section class="crk-root crk-section" data-crk-section="informant-intake">
  <div class="crk-inner crk-grid">
    <div class="crk-panel crk-intake__panel">
      {%- if section.settings.heading != blank -%}
        <h2 class="crk-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="crk-intake__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="crk-intake__app">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {%- render block -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- else -%}
      {%- form 'contact', class: 'crk-intake__form', id: 'crk-informant' -%}
          {%- comment -%}
            Shopify names every contact[*] field in the notification email, so
            these read as a register entry rather than as form debris.
          {%- endcomment -%}
          <input type="hidden" name="contact[Register]" value="{{ section.settings.register_name | escape }}">
  
          <div class="crk-intake__field">
            <label class="crk-eyebrow crk-intake__label" for="crk-informant-phone">
              {{ section.settings.phone_label }}
            </label>
            <input
              class="crk-input"
              id="crk-informant-phone"
              type="tel"
              name="contact[phone]"
              inputmode="tel"
              autocomplete="tel"
              placeholder="{{ section.settings.phone_placeholder | escape }}"
              required
            >
          </div>
  
          <div class="crk-intake__field">
            <label class="crk-eyebrow crk-intake__label" for="crk-informant-email">
              {{ section.settings.email_label }}
              <span class="crk-intake__optional">{{ section.settings.optional_label }}</span>
            </label>
            <input
              class="crk-input"
              id="crk-informant-email"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              placeholder="{{ section.settings.email_placeholder | escape }}"
            >
          </div>
  
          {%- if section.settings.consent_text != blank -%}
            <label class="crk-intake__consent" for="crk-informant-consent">
              <input
                class="crk-check"
                id="crk-informant-consent"
                type="checkbox"
                name="contact[Consent]"
                value="{{ section.settings.consent_value | escape }}"
                required
              >
              <span>{{ section.settings.consent_text }}</span>
            </label>
          {%- endif -%}
  
          <button class="crk-btn crk-btn--fill crk-intake__go" type="submit">{{ section.settings.button_label }}</button>
  
          {%- if form.posted_successfully? -%}
            <p class="crk-intake__msg crk-intake__msg--ok" role="status">{{ section.settings.success_text }}</p>
          {%- elsif form.errors -%}
            <p class="crk-intake__msg crk-intake__msg--err" role="alert">
              {{ section.settings.error_text }}
            </p>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.small_print != blank -%}
        <p class="crk-intake__small">{{ section.settings.small_print }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Crooks — Informant Intake",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "RECOMMENDED: add your Shopify Forms or Omnisend block to this section (Add block → the app). Both are already installed, and either one saves a real customer with real SMS marketing consent. It renders inside the terminal frame and replaces the fallback form." },
    { "type": "paragraph", "content": "FALLBACK, used only when no app block is added: the fields below post as a contact form. The number reaches your store inbox, but no customer and no consent record is created — a Liquid form cannot do that." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "REGISTER AS INFORMANT" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Drops go to the register before they go public. One message per drop, nothing else." },
    { "type": "header", "content": "Fields" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "MOBILE NUMBER" },
    { "type": "text", "id": "phone_placeholder", "label": "Phone placeholder", "default": "07700 900123" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "EMAIL" },
    { "type": "text", "id": "optional_label", "label": "Optional marker", "default": "OPTIONAL" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "EMAIL ADDRESS" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join" },
    { "type": "header", "content": "Consent" },
    { "type": "textarea", "id": "consent_text", "label": "Consent checkbox text", "default": "Text me when a drop lands. I can stop at any time." },
    { "type": "text", "id": "consent_value", "label": "Value recorded in the email", "default": "YES — SMS marketing consent given on the storefront" },
    { "type": "text", "id": "register_name", "label": "Register name in the email", "default": "SMS DROP LIST" },
    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "CLEARANCE ACCEPTED — RECORD SUBMITTED" },
    { "type": "text", "id": "error_text", "label": "Error message", "default": "SUBMISSION REJECTED — CHECK THE NUMBER" },
    { "type": "textarea", "id": "small_print", "label": "Small print", "default": "One text per drop. Reply STOP to leave the register at any time. We do not sell it." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Crooks — Informant Intake" }]
}
{% endschema %}
