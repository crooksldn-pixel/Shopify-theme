{{ 'crooks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'crooks-terminal.js' | asset_url }}" defer></script>

{%- liquid
  assign crk_products = collections[section.settings.collection].products
  assign crk_total = crk_products.size

  comment
    Build the list of categories actually present, from product.type. Never a
    hardcoded list: a type that disappears from the catalogue must not leave a
    dead filter behind. Delimiters guard against substring collisions.
  endcomment
  assign crk_seen = '|'
  for product in crk_products
    assign crk_type = product.type | upcase
    if crk_type != blank
      assign crk_probe = '|' | append: crk_type | append: '|'
      unless crk_seen contains crk_probe
        assign crk_seen = crk_seen | append: crk_type | append: '|'
      endunless
    endif
  endfor

  comment
    Order them: preferred order first (only those present), then anything else.
  endcomment
  assign crk_ordered = ''
  assign crk_pref = section.settings.category_order | split: ','
  for pref in crk_pref
    assign pref_clean = pref | strip | upcase
    assign crk_probe = '|' | append: pref_clean | append: '|'
    if pref_clean != blank and crk_seen contains crk_probe
      assign crk_ordered = crk_ordered | append: pref_clean | append: '|'
    endif
  endfor
  assign crk_present = crk_seen | split: '|'
  for cat in crk_present
    assign crk_probe = '|' | append: cat | append: '|'
    assign crk_ordered_probe = '|' | append: crk_ordered
    if cat != blank
      unless crk_ordered contains crk_probe or crk_ordered_probe contains crk_probe
        assign crk_ordered = crk_ordered | append: cat | append: '|'
      endunless
    endif
  endfor
  assign crk_categories = crk_ordered | split: '|'
-%}

<section class="crk-root crk-section crk-exhibit-log" data-crk-section="exhibit-log" data-crk-view="product" id="{{ section.settings.anchor_id | default: 'exhibits' }}">
  <div class="crk-inner">
    <header class="crk-log__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="crk-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="crk-eyebrow">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <span class="crk-log__count crk-micro">{{ crk_total }} {{ section.settings.count_label }}</span>
    </header>

    {%- if section.settings.show_view_toggle -%}
      {%- comment -%}
        Product / Model view. Client-side over already-rendered cards, exactly
        like the category filters — no fetch, no reload.
      {%- endcomment -%}
      <div class="crk-views" role="group" aria-label="{{ section.settings.view_group_label | escape }}">
        <button type="button" class="crk-filter" data-crk-view-btn="product" aria-pressed="true">
          {{ section.settings.label_view_product }}
        </button>
        <button type="button" class="crk-filter" data-crk-view-btn="model" aria-pressed="false">
          {{ section.settings.label_view_model }}
        </button>
      </div>
    {%- endif -%}

    {%- if section.settings.show_filters and crk_categories.size > 0 -%}
      <div class="crk-filters" role="group" aria-label="{{ section.settings.filters_label | escape }}">
        <button type="button" class="crk-filter" data-crk-filter="ALL" aria-pressed="true">
          {{ section.settings.all_label }}
        </button>
        {%- for cat in crk_categories -%}
          {%- if cat != blank -%}
            <button type="button" class="crk-filter" data-crk-filter="{{ cat | escape }}" aria-pressed="false">
              {{ cat }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <ul class="crk-log__grid">
      {%- for product in crk_products -%}
        {%- liquid
          assign crk_cat = product.type | upcase
          assign crk_main = product.featured_image
          assign crk_alt = product.images[1]

          comment
            Filing date. The status slot rendered a constant on all fourteen cards, so
            the register could not tell a returning shopper what had changed. A date is
            more in voice than "NEW" and it is a fact rather than a claim — it reports
            when the product went on the storefront, nothing more.

            The window is a setting because it is the merchant's editorial call: too wide
            and every card is stamped, which is the same as no signal at all.
          endcomment
          comment
            Colourway swatches. Generic: the option treated as "colour" comes from a
            setting, because this catalogue already spells it two ways — three tees use
            "Colour" and CRXST*RZ uses "Color" — and a future product may use neither.

            Colour source, in order: the merchant's configured Shopify swatch, else the
            option value used directly as a CSS colour keyword (BLACK, WHITE, NAVY... all
            resolve). Nothing is hardcoded and no colour is invented: if neither resolves
            the square renders empty-with-a-rule and the hidden text still names it.

            Only rendered when the option has more than one value — "available in one
            colour" is not information.
          endcomment
          assign crk_sw = null
          assign crk_sw_pos = 0
          if section.settings.show_colourways
            assign crk_names = section.settings.colour_option_names | downcase
            for opt in product.options_with_values
              assign crk_nm = opt.name | downcase | strip
              assign crk_probe = ',' | append: crk_nm | append: ','
              assign crk_hay = ',' | append: crk_names | append: ','
              assign crk_hay = crk_hay | replace: ', ', ','
              if crk_hay contains crk_probe and opt.values.size > 1
                assign crk_sw = opt
                assign crk_sw_pos = forloop.index
                break
              endif
            endfor
          endif

          comment
            One pass over the variants to learn which colourways are actually buyable.
            A swatch for a colourway that is entirely gone would be a lie on a card the
            shopper has not opened yet.
          endcomment
          assign crk_sw_live = '|'
          if crk_sw
            for v in product.variants
              if v.available
                case crk_sw_pos
                  when 1
                    assign crk_vv = v.option1
                  when 2
                    assign crk_vv = v.option2
                  else
                    assign crk_vv = v.option3
                endcase
                assign crk_probe = '|' | append: crk_vv | append: '|'
                unless crk_sw_live contains crk_probe
                  assign crk_sw_live = crk_sw_live | append: crk_vv | append: '|'
                endunless
              endif
            endfor
          endif

          assign crk_filed = false
          if product.published_at and section.settings.filed_days > 0
            assign crk_now_s = 'now' | date: '%s' | times: 1
            assign crk_pub_s = product.published_at | date: '%s' | times: 1
            assign crk_age = crk_now_s | minus: crk_pub_s | divided_by: 86400
            if crk_age >= 0 and crk_age <= section.settings.filed_days
              assign crk_filed = true
              comment
                Format the date into its own variable first. Inlining it as
                `filed_label | replace: '[date]', product.published_at | date: fmt`
                parses as replace(...) THEN date(...), so `date` reformats the whole
                replaced string and swallows the label — it rendered "13.07", not
                "FILED 13.07".
              endcomment
              assign crk_filed_on = product.published_at | date: section.settings.filed_format
            endif
          endif
          comment
            Outline everything EXCEPT JPEG. JPEG cannot carry an alpha channel,
            so a JPEG product shot always has a baked-in background and the
            filter would trace the rectangle rather than the garment. PNG and
            WebP both support alpha and this catalogue uses both — testing for
            .png alone wrongly excluded six cut-out WebP files. Verified against
            the source audit in NOTES.md: every baked-white image is a JPEG and
            every non-JPEG is a clean cut-out.
          endcomment
          assign main_src = crk_main.src | downcase
          assign alt_src = crk_alt.src | downcase
          assign main_cls = 'crk-card__img crk-card__img--main'
          unless main_src contains '.jpg' or main_src contains '.jpeg'
            assign main_cls = main_cls | append: ' crk-product-image'
          endunless
          assign alt_cls = 'crk-card__img crk-card__img--alt'
          unless alt_src contains '.jpg' or alt_src contains '.jpeg'
            assign alt_cls = alt_cls | append: ' crk-product-image'
          endunless
          comment
            Model view. A real per-product shot wins; otherwise the section's
            placeholder stands in, so the treatment can be judged across the
            whole grid before every product has been shot.
          endcomment
          assign crk_model = product.metafields.crooks.model_image.value
          assign crk_model_is_real = true
          unless crk_model
            assign crk_model = section.settings.model_placeholder
            assign crk_model_is_real = false
          endunless
          assign model_src = crk_model.src | downcase
          assign model_cls = 'crk-card__img crk-card__img--model'
          unless model_src contains '.jpg' or model_src contains '.jpeg'
            assign model_cls = model_cls | append: ' crk-product-image'
          endunless
        -%}
        <li class="crk-log__cell" data-crk-category="{{ crk_cat | escape }}"{% if crk_model %} data-crk-has-model="{% if crk_model_is_real %}real{% else %}placeholder{% endif %}"{% endif %}>
          <a
            class="crk-card{% if crk_alt %} crk-card--swap{% endif %}{% unless product.available %} crk-card--sold{% endunless %}"
            href="{{ product.url }}"
          >
            <span class="crk-card__top crk-micro">
              <span>{{ section.settings.exhibit_prefix }} {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <span>{{ crk_cat }}</span>
            </span>
            <span class="crk-card__media">
              {%- if crk_main -%}
                {{
                  crk_main
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400, 600, 800',
                    sizes: '(min-width: 1024px) 25vw, 50vw',
                    class: main_cls,
                    alt: crk_main.alt
                }}
              {%- endif -%}
              {%- if crk_alt -%}
                {{
                  crk_alt
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400, 600, 800',
                    sizes: '(min-width: 1024px) 25vw, 50vw',
                    class: alt_cls,
                    alt: ''
                }}
              {%- endif -%}
              {%- if crk_model -%}
                {{
                  crk_model
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400, 600, 800',
                    sizes: '(min-width: 1024px) 25vw, 50vw',
                    class: model_cls,
                    alt: ''
                }}
              {%- endif -%}
            </span>
            <span class="crk-card__name">{% render 'crooks-title', product: product %}</span>
            {%- if crk_sw -%}
              {%- capture crk_sw_names -%}
                {%- for val in crk_sw.values -%}
                  {%- assign nm = val.name | default: val -%}
                  {{ nm }}{% unless forloop.last %}, {% endunless %}
                {%- endfor -%}
              {%- endcapture -%}
              <span class="crk-card__sw" aria-hidden="true">
                {%- for val in crk_sw.values -%}
                  {%- liquid
                    assign nm = val.name | default: val
                    assign col = val.swatch.color
                    if col == blank
                      assign col = nm | downcase | replace: ' ', ''
                    endif
                    assign probe = '|' | append: nm | append: '|'
                    assign live = true
                    unless crk_sw_live contains probe
                      assign live = false
                    endunless
                  -%}
                  <span class="crk-card__swatch" style="--crk-sw: {{ col }}"{% unless live %} data-crk-sw-out="true"{% endunless %}></span>
                {%- endfor -%}
              </span>
              <span class="crk-sr">{{ section.settings.colourways_sr_label }}: {{ crk_sw_names | strip }}</span>
            {%- endif -%}
            <span class="crk-card__row">
              <span class="crk-price">{{ product.price | money }}</span>
              <span class="crk-card__status"{% if crk_filed and product.available %} data-crk-filed="true"{% endif %}>
                {%- if product.available == false -%}
                  {{ section.settings.sold_out_label }}
                {%- elsif crk_filed -%}
                  {{ section.settings.filed_label | replace: '[date]', crk_filed_on }}
                {%- else -%}
                  {{ section.settings.available_label }}
                {%- endif -%}
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- comment -%}
      Shown by JS when a filter matches nothing. Visible without JS only when the
      collection itself is empty, which is the honest state in that case.
    {%- endcomment -%}
    {%- if section.settings.empty_text != blank -%}
      <p class="crk-log__empty"{% if crk_total > 0 %} hidden{% endif %}>{{ section.settings.empty_text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Crooks — Catalogue",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CATALOGUE" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "ITEMS" },
    { "type": "text", "id": "exhibit_prefix", "label": "Product number prefix", "default": "NO." },
    { "type": "header", "content": "View mode" },
    { "type": "checkbox", "id": "show_view_toggle", "label": "Show Product / Model view toggle", "default": true },
    { "type": "text", "id": "label_view_product", "label": "Product view label", "default": "PRODUCT" },
    { "type": "text", "id": "label_view_model", "label": "Model view label", "default": "MODEL" },
    { "type": "text", "id": "view_group_label", "label": "View toggle label (screen readers)", "default": "Choose how products are shown" },
    { "type": "image_picker", "id": "model_placeholder", "label": "Model view placeholder", "info": "Stands in for any product with no Model image metafield set. Leave empty to show the product image instead." },
    { "type": "header", "content": "Filters" },
    { "type": "checkbox", "id": "show_filters", "label": "Show category filters", "default": true },
    { "type": "text", "id": "all_label", "label": "\"All\" filter label", "default": "ALL" },
    {
      "type": "text",
      "id": "category_order",
      "label": "Preferred category order",
      "info": "Comma-separated. Categories come from each product's type. Any present category not listed here is appended at the end; any listed category with no products is skipped.",
      "default": "T-SHIRT, DENIM, SWEATS, ACCESSORIES"
    },
    { "type": "text", "id": "filters_label", "label": "Filter group label (screen readers)", "default": "Filter products" },
    { "type": "header", "content": "Status labels" },
    { "type": "checkbox", "id": "show_colourways", "label": "Show colourway swatches on cards", "default": true },
    { "type": "text", "id": "colour_option_names", "label": "Option names treated as colourways", "info": "Comma separated. Matched case-insensitively.", "default": "Colour,Color,Colourway,Colorway" },
    { "type": "text", "id": "colourways_sr_label", "label": "Colourways label (screen readers)", "default": "Colourways" },
    { "type": "text", "id": "available_label", "label": "Available label", "default": "AVAILABLE" },
    { "type": "text", "id": "filed_label", "label": "Recently filed label", "info": "Use [date]. Replaces the available label for products published inside the window below.", "default": "FILED [date]" },
    { "type": "text", "id": "filed_format", "label": "Filing date format", "info": "Liquid date format. %d.%m gives 08.08.", "default": "%d.%m" },
    { "type": "range", "id": "filed_days", "label": "Treat as recently filed for", "unit": "d", "min": 0, "max": 90, "step": 1, "default": 30 },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "SOLD OUT" },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "NO PRODUCTS MATCH THIS CATEGORY." },
    { "type": "header", "content": "Advanced" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "info": "Used by in-page links such as the hero's primary button.", "default": "exhibits" }
  ],
  "presets": [{ "name": "Crooks — Catalogue" }]
}
{% endschema %}
