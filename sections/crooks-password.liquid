{{ 'crooks.css' | asset_url | stylesheet_tag }}
{{ 'crooks-password.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  CROOKSLDN — the lock-up. Password / holding page.

  The stock password page was a logo, a signup box and a Shopify footer. This
  replaces it with the thing the brand is actually about: a premises that is
  secured, a clock running down to the hour it opens, and someone outside
  working on the door.

  WHAT IS TRUE HERE, AND WHAT IS SCENERY

  True, and load-bearing:
    - The countdown. It targets an absolute instant computed in Liquid from
      the SHOP's clock (Europe/London), not the visitor's. Someone opening
      this in New York sees the time remaining until 18:00 London, which is
      the only meaning "6pm" can have for a London store.
    - The unlock line at zero. It does NOT claim the store is open — the
      password only comes off when George takes it off — so it says the
      doors are being opened and offers a reload.

  Scenery, and marked as such:
    - The thief, the vault, the drill, the sparks, the dial. All inline SVG,
      all aria-hidden, all stopped under prefers-reduced-motion. None of it
      carries information that is not also written in text.
    - The waiting counter. This is a simulated number and the schema says so
      in plain words. Set counter_mode to "fixed" and it shows a real figure
      you type in — your actual mailing list — instead.

  TIMEZONE. Liquid's `date` filter renders in the shop's timezone, so the
  hour/minute/second of "now" are London wall-clock. Subtracting those from
  the epoch gives London midnight as an absolute instant; adding the target
  time gives the target as an absolute instant. That survives the visitor
  being in any timezone. It is off by an hour only on the two days a year a
  DST boundary falls between midnight and the target, which for an 18:00
  unlock it never does — the UK switches at 01:00/02:00.

  No Liquid inside script or style tags. Everything the JS needs arrives on
  data- attributes.
{%- endcomment -%}

{%- liquid
  assign crk_now = 'now' | date: '%s' | plus: 0

  # London wall-clock components of "now"
  assign crk_h = 'now' | date: '%H' | plus: 0
  assign crk_m = 'now' | date: '%M' | plus: 0
  assign crk_s = 'now' | date: '%S' | plus: 0

  # Epoch of London midnight today. Built in steps: filters chain left to
  # right with no grouping, so times/plus must not share a line.
  assign crk_elapsed = crk_h | times: 3600
  assign crk_mins = crk_m | times: 60
  assign crk_elapsed = crk_elapsed | plus: crk_mins
  assign crk_elapsed = crk_elapsed | plus: crk_s
  assign crk_midnight = crk_now | minus: crk_elapsed

  # The target time, HH:MM.
  assign crk_time = section.settings.unlock_time | default: '18:00'
  assign crk_parts = crk_time | split: ':'
  assign crk_th = crk_parts[0] | plus: 0
  assign crk_tm = crk_parts[1] | plus: 0
  assign crk_offset = crk_th | times: 3600
  assign crk_tmins = crk_tm | times: 60
  assign crk_offset = crk_offset | plus: crk_tmins
  assign crk_target = crk_midnight | plus: crk_offset

  # Blank date means "the next time that clock reads 18:00". A date pins it
  # to one specific day, for a launch more than a day out.
  if section.settings.unlock_date != blank
    assign crk_stamp = section.settings.unlock_date | append: ' ' | append: crk_time
    assign crk_target = crk_stamp | date: '%s' | plus: 0
  elsif crk_target <= crk_now
    assign crk_target = crk_target | plus: 86400
  endif

  assign crk_span = section.settings.progress_hours | times: 3600
  assign crk_label = crk_target | date: '%H:%M'
-%}

<section
  class="crk-root crk-pw"
  data-crk-section="password"
  data-crk-state="waiting"
  data-crk-target="{{ crk_target }}"
  data-crk-span="{{ crk_span }}"
  data-crk-count-mode="{{ section.settings.counter_mode }}"
  data-crk-count-base="{{ section.settings.counter_base }}"
  data-crk-count-drift="{{ section.settings.counter_drift }}"
  data-crk-open-heading="{{ section.settings.open_heading | escape }}"
  data-crk-open-sub="{{ section.settings.open_subheading | escape }}"
>

  {%- if section.settings.status_line != blank -%}
    <p class="crk-pw__status">
      <span class="crk-pw__beacon" aria-hidden="true"></span>
      <span class="crk-pw__statustext">{{ section.settings.status_line }}</span>
    </p>
  {%- endif -%}

  <div class="crk-pw__inner">

    {%- comment -%} Wordmark: an uploaded logo if there is one, the text if not. {%- endcomment -%}
    <div class="crk-pw__mark">
      {%- if section.settings.logo != blank -%}
        <img
          class="crk-pw__logo"
          src="{{ section.settings.logo | image_url: width: 640 }}"
          alt="{{ shop.name | escape }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          loading="eager"
        >
      {%- elsif section.settings.wordmark != blank -%}
        <p class="crk-pw__wordmark">{{ section.settings.wordmark }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.heading != blank -%}
      <h1 class="crk-pw__heading" data-crk-heading>{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="crk-pw__sub" data-crk-sub>
        {{- section.settings.subheading | replace: '[time]', crk_label -}}
      </p>
    {%- endif -%}

    {%- comment -%}
      The clock. aria-live is polite and only the whole-minute value is
      announced (see the JS) — a per-second live region would make a screen
      reader unusable.
    {%- endcomment -%}
    <div class="crk-pw__clock" role="timer" aria-live="polite" aria-atomic="true">
      <span class="crk-sr" data-crk-spoken></span>
      <div class="crk-pw__units" aria-hidden="true">
        <div class="crk-pw__unit">
          <span class="crk-pw__digits" data-crk-hh>--</span>
          <span class="crk-pw__unitlabel">{{ section.settings.label_hours }}</span>
        </div>
        <span class="crk-pw__colon">:</span>
        <div class="crk-pw__unit">
          <span class="crk-pw__digits" data-crk-mm>--</span>
          <span class="crk-pw__unitlabel">{{ section.settings.label_minutes }}</span>
        </div>
        <span class="crk-pw__colon">:</span>
        <div class="crk-pw__unit">
          <span class="crk-pw__digits" data-crk-ss>--</span>
          <span class="crk-pw__unitlabel">{{ section.settings.label_seconds }}</span>
        </div>
      </div>
    </div>

    {%- comment -%}
      The scene. Entirely decorative: hidden from assistive technology, and
      every moving part is switched off under prefers-reduced-motion, which
      leaves a still frame of a figure at a vault door.
    {%- endcomment -%}
    {%- if section.settings.show_scene -%}
      <div class="crk-pw__scene" aria-hidden="true">
        <svg class="crk-pw__svg" viewBox="0 0 320 200" role="presentation" focusable="false">

          <!-- floor -->
          <line class="crk-pw__floor" x1="8" y1="182" x2="312" y2="182"/>

          <!-- ── the vault ────────────────────────────────────── -->
          <g class="crk-pw__vault">
            <rect class="crk-pw__plate" x="150" y="18" width="162" height="164"/>
            <!-- door seam, and the leaf that swings at zero -->
            <g class="crk-pw__door">
              <circle class="crk-pw__ring" cx="231" cy="100" r="70"/>
              <circle class="crk-pw__ring" cx="231" cy="100" r="56"/>
              <circle class="crk-pw__ring crk-pw__ring--thin" cx="231" cy="100" r="34"/>

              <!-- bolts -->
              <circle class="crk-pw__bolt" cx="231" cy="37" r="3"/>
              <circle class="crk-pw__bolt" cx="275" cy="55" r="3"/>
              <circle class="crk-pw__bolt" cx="294" cy="100" r="3"/>
              <circle class="crk-pw__bolt" cx="275" cy="145" r="3"/>
              <circle class="crk-pw__bolt" cx="231" cy="163" r="3"/>
              <circle class="crk-pw__bolt" cx="187" cy="145" r="3"/>
              <circle class="crk-pw__bolt" cx="168" cy="100" r="3"/>
              <circle class="crk-pw__bolt" cx="187" cy="55" r="3"/>

              <!-- the dial. Rotates with the countdown: --crk-dial is set
                   by the JS, so the wheel turns as the clock runs down. -->
              <g class="crk-pw__dial">
                <line class="crk-pw__spoke" x1="231" y1="58" x2="231" y2="142"/>
                <line class="crk-pw__spoke" x1="195" y1="79" x2="267" y2="121"/>
                <line class="crk-pw__spoke" x1="195" y1="121" x2="267" y2="79"/>
                <circle class="crk-pw__hub" cx="231" cy="100" r="11"/>
                <line class="crk-pw__notch" x1="231" y1="66" x2="231" y2="76"/>
              </g>
            </g>
          </g>

          <!-- ── sparks at the contact point ───────────────────── -->
          <g class="crk-pw__sparks">
            <line class="crk-pw__spark" x1="161" y1="100" x2="147" y2="85"/>
            <line class="crk-pw__spark" x1="161" y1="100" x2="142" y2="97"/>
            <line class="crk-pw__spark" x1="161" y1="100" x2="147" y2="115"/>
            <line class="crk-pw__spark" x1="161" y1="100" x2="153" y2="78"/>
            <line class="crk-pw__spark" x1="161" y1="100" x2="153" y2="122"/>
          </g>

          <!-- ── the thief ────────────────────────────────────
               Built from the ground up at y=182 so the stance reads as
               braced rather than floating: back leg planted wide, front leg
               taking the recoil, both hands on the drill. Head is a circle
               with the beanie as a half-disc over the top of it and the mask
               band across the eyeline, which leaves a jaw showing — without
               that the head is a featureless blob. -->
          <g class="crk-pw__thief">
            <!-- back leg, planted -->
            <path class="crk-pw__limb" d="M73 136 L62 180"/>
            <!-- front leg, braced against the drill -->
            <path class="crk-pw__limb" d="M83 136 L93 180"/>
            <!-- torso -->
            <path class="crk-pw__body" d="M69 95 L87 95 L85 138 L71 138 Z"/>
            <!-- head -->
            <circle class="crk-pw__body" cx="78" cy="84" r="11"/>
            <!-- beanie: half-disc over the crown, plus a brim that overhangs -->
            <path class="crk-pw__body" d="M67 84 A11 11 0 0 1 89 84 Z"/>
            <rect class="crk-pw__body" x="64" y="80" width="28" height="5"/>
            <!-- mask across the eyeline -->
            <rect class="crk-pw__mask" x="67" y="86" width="22" height="6"/>
            <!-- rear arm, low on the grip -->
            <path class="crk-pw__limb" d="M73 106 L110 117"/>
            <!-- front arm, up on the barrel -->
            <path class="crk-pw__limb" d="M86 99 L106 101"/>
          </g>

          <!-- ── the drill ────────────────────────────────────
               The bit ends at x=161, which is exactly where the vault's
               outer ring is, so the tip touches the door rather than
               hovering near it. The sparks share that origin. -->
          <g class="crk-pw__drill">
            <rect class="crk-pw__drillbody" x="100" y="92" width="33" height="19"/>
            <rect class="crk-pw__drillgrip" x="106" y="111" width="11" height="15"/>
            <line class="crk-pw__bit" x1="133" y1="101" x2="161" y2="100"/>
            <line class="crk-pw__bit crk-pw__bit--fine" x1="133" y1="104" x2="157" y2="103"/>
          </g>

        </svg>

        {%- comment -%}
          Drill depth. A progress bar for the countdown, dressed as the hole
          getting deeper. Purely a second reading of the clock above.
        {%- endcomment -%}
        <div class="crk-pw__depth">
          <span class="crk-pw__depthlabel">{{ section.settings.progress_label }}</span>
          <span class="crk-pw__track"><span class="crk-pw__fill" data-crk-fill></span></span>
          <span class="crk-pw__depthpct" data-crk-pct>0%</span>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}
      The waiting counter. Simulated by default — the schema says so — and
      switchable to a fixed, real number you type in.
    {%- endcomment -%}
    {%- if section.settings.counter_mode != 'off' and section.settings.counter_text != blank -%}
      <p class="crk-pw__waiting">
        <span class="crk-pw__pulse" aria-hidden="true"></span>
        <span data-crk-count>{{ section.settings.counter_base }}</span>
        {{ section.settings.counter_text }}
      </p>
    {%- endif -%}

    {%- comment -%}
      Shown only when the clock reaches zero. The store does not unlock
      itself, so this offers a reload rather than claiming to be open.
    {%- endcomment -%}
    <div class="crk-pw__open" data-crk-open hidden>
      <button class="crk-btn crk-btn--fill crk-pw__enter" type="button" data-crk-reload>
        {{ section.settings.open_cta }}
      </button>
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="crk-micro crk-pw__foot">{{ section.settings.footnote }}</p>
    {%- endif -%}

  </div>
</section>

<script src="{{ 'crooks-password.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Crooks — lock-up",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "When it opens" },
    { "type": "text", "id": "unlock_time", "label": "Unlock time", "info": "24-hour, HH:MM, in the shop's timezone (Europe/London). Visitors abroad see the time remaining until this instant, not until 18:00 where they are.", "default": "18:00" },
    { "type": "text", "id": "unlock_date", "label": "Unlock date (optional)", "info": "YYYY-MM-DD. Leave blank and the clock runs to the next time it reads the unlock time — today if that is still ahead, tomorrow if it has passed.", "default": "" },
    { "type": "range", "id": "progress_hours", "label": "Drill bar covers the last", "unit": "h", "min": 1, "max": 48, "step": 1, "default": 12, "info": "How long the progress bar takes to fill. At 12, the bar starts moving 12 hours before the unlock." },

    { "type": "header", "content": "Words" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "wordmark", "label": "Wordmark (used if no logo)", "default": "CROOKSLDN" },
    { "type": "text", "id": "status_line", "label": "Status line", "default": "PREMISES SECURED // ENTRY RESTRICTED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "THE LOCK-UP IS SHUT" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "info": "Write [time] where the unlock time should appear and it will be filled in automatically.", "default": "Doors go up at [time]. Nothing is coming out before then." },
    { "type": "text", "id": "label_hours", "label": "Hours label", "default": "HRS" },
    { "type": "text", "id": "label_minutes", "label": "Minutes label", "default": "MIN" },
    { "type": "text", "id": "label_seconds", "label": "Seconds label", "default": "SEC" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "CROOKS CLOTHING COMPANY LTD // REGISTERED IN ENGLAND AND WALES" },

    { "type": "header", "content": "The scene" },
    { "type": "checkbox", "id": "show_scene", "label": "Show the vault and the drill", "default": true },
    { "type": "text", "id": "progress_label", "label": "Progress label", "default": "DRILL DEPTH" },

    { "type": "header", "content": "Waiting counter" },
    {
      "type": "select",
      "id": "counter_mode",
      "label": "Counter",
      "info": "SIMULATED invents a number that drifts up and down. It is not a real measurement — nothing on a password page can count live visitors — so treat it as scenery. FIXED shows the number below exactly as typed, which is the honest option if you put your real mailing-list size in it.",
      "options": [
        { "value": "simulated", "label": "Simulated (drifts)" },
        { "value": "fixed", "label": "Fixed number" },
        { "value": "off", "label": "Hide it" }
      ],
      "default": "simulated"
    },
    { "type": "number", "id": "counter_base", "label": "Number", "default": 214 },
    { "type": "range", "id": "counter_drift", "label": "Drift", "min": 0, "max": 200, "step": 5, "default": 40, "unit": "±", "info": "Simulated mode only. How far the number wanders from the number above." },
    { "type": "text", "id": "counter_text", "label": "Text after the number", "default": "waiting on the door" },

    { "type": "header", "content": "At zero" },
    { "type": "text", "id": "open_heading", "label": "Heading", "default": "THE DOOR IS COMING OFF" },
    { "type": "textarea", "id": "open_subheading", "label": "Subheading", "default": "Opening up now. Give it a minute and reload." },
    { "type": "text", "id": "open_cta", "label": "Button", "default": "TRY THE DOOR" }
  ],
  "presets": [{ "name": "Crooks — lock-up" }]
}
{% endschema %}
