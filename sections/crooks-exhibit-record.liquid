{{ 'crooks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'crooks-record.js' | asset_url }}" defer></script>

{%- liquid
  assign crk_var = product.selected_or_first_available_variant
  assign crk_col = collections[section.settings.collection]

  assign crk_index = 0
  assign crk_total = crk_col.products_count
  for p in crk_col.products
    if p.id == product.id
      assign crk_index = forloop.index
      break
    endif
  endfor

  comment
    Size option = the first option that is not Title.
  endcomment
  assign crk_size_opt = null
  for opt in product.options_with_values
    assign opt_down = opt.name | downcase
    if opt_down != 'title' and crk_size_opt == null
      assign crk_size_opt = opt
    endif
  endfor
  assign crk_single = false
  if product.variants.size == 1 and product.variants.first.title == 'Default Title'
    assign crk_single = true
    assign crk_size_opt = null
  endif

  assign mf = product.metafields.crooks
  assign rows = mf.measurements.value
  assign has_measurements = false
  if rows and rows.size > 0
    assign has_measurements = true
  endif
-%}

<div
  class="crk-root crk-record"
  data-crk-section="exhibit-record"
  data-crk-label-add="{{ section.settings.label_add | escape }}"
  data-crk-label-select="{{ section.settings.label_select | escape }}"
  data-crk-label-sold="{{ section.settings.label_sold | escape }}"
  data-crk-label-instock="{{ section.settings.label_in_stock | escape }}"
  data-crk-label-low="{{ section.settings.label_low | escape }}"
  data-crk-label-soldsize="{{ section.settings.label_sold_size | escape }}"
  data-crk-photo-label="{{ section.settings.photo_label | escape }}"
  {%- unless section.settings.show_texture %} data-crk-texture="off"{% endunless %}
>

  <div class="crk-wrap">
    {%- comment -%} ---------- meta strip ---------- {%- endcomment -%}
    <header class="crk-meta">
      <a href="{{ crk_col.url | default: routes.root_url }}" class="crk-label">{{ section.settings.back_label }}</a>
      {%- if crk_index > 0 -%}
        <span class="crk-display crk-meta-exh">
          {{ section.settings.exhibit_word }} {% if crk_index < 10 %}0{% endif %}{{ crk_index }} / {{ crk_total }}
        </span>
      {%- endif -%}
      {%- if product.type != blank -%}
        <span class="crk-data crk-dim">{{ product.type | upcase }}</span>
      {%- endif -%}
      {%- if mf.case_ref.value != blank -%}
        <span class="crk-data crk-dim">{{ section.settings.case_word }} {{ mf.case_ref.value }}</span>
      {%- endif -%}
    </header>

    <div class="crk-grid">
      {%- comment -%} ---------- gallery ---------- {%- endcomment -%}
      <div>
        <div
          class="crk-tray crk-tray-main"
          role="group"
          aria-label="{{ section.settings.gallery_label | escape }}"
          tabindex="0"
          data-crk-gallery
        >
          {%- for image in product.images -%}
            {%- liquid
              if forloop.first
                assign img_loading = 'eager'
              else
                assign img_loading = 'lazy'
              endif
              assign img_alt = image.alt | default: product.title
              assign gal_src = image.src | downcase
              assign main_img_cls = 'crk-main-img'
              unless gal_src contains '.jpg' or gal_src contains '.jpeg'
                assign main_img_cls = main_img_cls | append: ' crk-product-image'
              endunless
            -%}
            <div data-crk-slide {% unless forloop.first %}hidden{% endunless %}>
              {{
                image
                | image_url: width: 1400
                | image_tag:
                  widths: '400, 600, 800, 1000, 1400',
                  sizes: '(min-width: 960px) 55vw, 100vw',
                  loading: img_loading,
                  class: main_img_cls,
                  alt: img_alt
              }}
            </div>
          {%- endfor -%}
        </div>

        <div class="crk-gallery-chrome">
          <span class="crk-counter" data-crk-photo-counter aria-hidden="true">
            {{ section.settings.photo_label | replace: '[i]', 1 | replace: '[n]', product.images.size }}
          </span>
        </div>

        {%- if product.images.size > 1 -%}
          <div class="crk-thumbs">
            {%- for image in product.images -%}
              <button
                type="button"
                class="crk-thumb"
                data-crk-thumb
                data-active="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ section.settings.photo_label | replace: '[i]', forloop.index | replace: '[n]', product.images.size | escape }}"
              >
                {{ image | image_url: width: 128 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- record panel ---------- {%- endcomment -%}
      <div class="crk-panel crk-panel-record crk-panel-sticky">
        <h1 class="crk-display crk-title">{% render 'crooks-title', product: product %}</h1>
        <div class="crk-display crk-price" style="margin-top: 4px;" data-crk-price>{{ crk_var.price | money }}</div>

        {%- if product.available -%}
          {%- form 'product', product, id: 'crk-product-form' -%}
            <input type="hidden" name="id" value="{{ crk_var.id }}" data-crk-variant-id>

            {%- if crk_size_opt -%}
              <div style="margin-top: 16px;">
                <div class="crk-label" style="display: block; margin-bottom: 8px;">{{ crk_size_opt.name }}</div>
                <div class="crk-sizes" role="group" aria-label="{{ section.settings.size_group_label | escape }}">
                  {%- for value in crk_size_opt.values -%}
                    {%- liquid
                      assign v_match = null
                      for v in product.variants
                        if v.options contains value and v_match == null
                          assign v_match = v
                        endif
                      endfor
                      comment
                        Buyability comes from variant.available, never from the
                        inventory count: policy differs per variant and oversold
                        CONTINUE variants remain purchasable (see NOTES.md).
                      endcomment
                      assign v_avail = false
                      if v_match and v_match.available
                        assign v_avail = true
                      endif
                      assign v_qty = 0
                      if v_match and v_match.inventory_quantity > 0
                        assign v_qty = v_match.inventory_quantity
                      endif
                      assign v_low = false
                      if v_avail and v_qty > 0 and v_qty <= section.settings.low_stock_threshold
                        assign v_low = true
                      endif
                      assign v_sel = false
                      if v_match.id == crk_var.id
                        assign v_sel = true
                      endif
                    -%}
                    <button
                      type="button"
                      class="crk-size"
                      data-size="{{ value | escape }}"
                      data-variant-id="{{ v_match.id }}"
                      data-available="{{ v_avail }}"
                      data-quantity="{{ v_qty }}"
                      data-price="{{ v_match.price | money }}"
                      data-selected="{{ v_sel }}"
                      data-low="{{ v_low }}"
                      aria-pressed="{{ v_sel }}"
                      aria-disabled="{% unless v_avail %}true{% endunless %}"
                      aria-label="{{ value }}{% unless v_avail %}, {{ section.settings.sr_sold_out }}{% endunless %}{% if v_low %}, {{ v_qty }} {{ section.settings.sr_left }}{% endif %}"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
                <p class="crk-stockline" data-crk-stockline data-out="false" aria-live="polite">
                  {{ section.settings.label_select }}
                </p>
                {%- if has_measurements -%}
                  <button type="button" class="crk-textbtn" style="margin-top: 8px;" data-crk-size-guide>
                    {{ section.settings.size_guide_label }}
                  </button>
                {%- endif -%}
              </div>

              <noscript>
                <p class="crk-micro" style="margin-top: 8px;">{{ section.settings.nojs_note }}</p>
                <ul class="crk-sizes">
                  {%- for v in product.variants -%}
                    {%- if v.available -%}
                      <li><a class="crk-size" href="{{ product.url }}?variant={{ v.id }}">{{ v.title }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </noscript>
            {%- else -%}
              <p class="crk-stockline" data-crk-stockline data-out="false" aria-live="polite">
                {%- if crk_var.inventory_quantity > 0 and crk_var.inventory_quantity <= section.settings.low_stock_threshold -%}
                  {{ section.settings.label_low | replace: '[n]', crk_var.inventory_quantity | replace: ' IN SIZE [size]', '' }}
                {%- else -%}
                  {{ section.settings.label_in_stock }}
                {%- endif -%}
              </p>
            {%- endif -%}

            {%- comment -%}
              Delivery expectation, carried over from the Horizon PDP's
              delivery-message block. Real shipping information a customer needs
              before buying, so it survives the redesign rather than being
              replaced by flavour.
            {%- endcomment -%}
            {%- liquid
              assign crk_mto = false
              if product.tags contains section.settings.made_to_order_tag
                assign crk_mto = true
              endif
            -%}
            {%- if crk_mto and section.settings.made_to_order_text != blank -%}
              <p class="crk-stockline">{{ section.settings.made_to_order_text }}</p>
            {%- elsif section.settings.in_stock_text != blank -%}
              <p class="crk-stockline">{{ section.settings.in_stock_text }}</p>
            {%- endif -%}

            {%- comment -%} App blocks (size charts, reviews) render here. {%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                <div {{ block.shopify_attributes }}>{% render block %}</div>
              {%- endif -%}
            {%- endfor -%}

            <span class="crk-label crk-buylabel">{{ section.settings.buy_label }}</span>
            <button type="submit" name="add" class="crk-btn" data-crk-buy>
              {%- if crk_size_opt -%}{{ section.settings.label_select }}{%- else -%}{{ section.settings.label_add }}{%- endif -%}
            </button>
          {%- endform -%}
        {%- else -%}
          <p class="crk-stockline" data-out="true">{{ section.settings.released_text }}</p>
          {%- form 'contact', class: 'crk-notify' -%}
            <input type="hidden" name="contact[subject]" value="{{ section.settings.notify_subject | escape }}">
            <input type="hidden" name="contact[product]" value="{{ product.handle }}">
            <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
            <label class="crk-label crk-buylabel" for="crk-notify-email">{{ section.settings.buy_label }}</label>
            <input
              class="crk-input"
              id="crk-notify-email"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.notify_placeholder | escape }}"
              autocomplete="email"
              required
            >
            <button class="crk-btn" type="submit" style="margin-top: 8px;">{{ section.settings.notify_button }}</button>
            {%- if form.posted_successfully? -%}
              <p class="crk-body" style="margin-top: 16px;" aria-live="polite">{{ section.settings.notify_ok }}</p>
            {%- elsif form.errors -%}
              <p class="crk-body" style="margin-top: 16px; color: var(--crk-red);" role="alert">{{ section.settings.notify_err }}</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- collapsible record sections ---------- {%- endcomment -%}
    <div class="crk-stack">
      <div>
        {%- liquid
          assign spec_count = 0
          if crk_single
            assign spec_count = 1
          endif
          if mf.fabric.value != blank
            assign spec_count = spec_count | plus: 1
          endif
          if mf.cut.value != blank
            assign spec_count = spec_count | plus: 1
          endif
          if mf.wash_code.value != blank
            assign spec_count = spec_count | plus: 1
          endif
          if mf.origin.value != blank
            assign spec_count = spec_count | plus: 1
          endif
          if mf.care.value != blank
            assign spec_count = spec_count | plus: 1
          endif
          if mf.case_ref.value != blank
            assign spec_count = spec_count | plus: 1
          endif
        -%}
        {%- if spec_count > 0 -%}
          <section class="crk-section" id="crk-specification">
            <h2 class="crk-display crk-h" style="margin: 0;">
              <button type="button" class="crk-section-head" data-crk-accordion aria-expanded="{% if section.settings.spec_open %}true{% else %}false{% endif %}" aria-controls="crk-specification-body">
                <span class="crk-display crk-h">{{ section.settings.spec_heading }}</span>
                <span class="crk-display crk-h" aria-hidden="true" data-crk-accordion-icon>{% if section.settings.spec_open %}−{% else %}+{% endif %}</span>
              </button>
            </h2>
            <div class="crk-section-body" id="crk-specification-body"{% unless section.settings.spec_open %} hidden{% endunless %}>
              <dl class="crk-spec">
                {%- if crk_single -%}<dt>{{ section.settings.row_size }}</dt><dd>{{ section.settings.one_size_text }}</dd>{%- endif -%}
                {%- if mf.fabric.value != blank -%}<dt>{{ section.settings.row_fabric }}</dt><dd>{{ mf.fabric.value }}</dd>{%- endif -%}
                {%- if mf.cut.value != blank -%}<dt>{{ section.settings.row_cut }}</dt><dd>{{ mf.cut.value }}</dd>{%- endif -%}
                {%- if mf.wash_code.value != blank -%}<dt>{{ section.settings.row_wash }}</dt><dd>{{ mf.wash_code.value }}</dd>{%- endif -%}
                {%- if mf.origin.value != blank -%}<dt>{{ section.settings.row_origin }}</dt><dd>{{ mf.origin.value }}</dd>{%- endif -%}
                {%- if mf.care.value != blank -%}<dt>{{ section.settings.row_care }}</dt><dd>{{ mf.care.value }}</dd>{%- endif -%}
                {%- if mf.case_ref.value != blank -%}<dt>{{ section.settings.row_case }}</dt><dd>{{ mf.case_ref.value }}</dd>{%- endif -%}
              </dl>
            </div>
          </section>
        {%- endif -%}

        {%- if product.description != blank -%}
          <section class="crk-section" id="crk-provenance">
            <h2 class="crk-display crk-h" style="margin: 0;">
              <button type="button" class="crk-section-head" data-crk-accordion aria-expanded="{% if section.settings.provenance_open %}true{% else %}false{% endif %}" aria-controls="crk-provenance-body">
                <span class="crk-display crk-h">{{ section.settings.provenance_heading }}</span>
                <span class="crk-display crk-h" aria-hidden="true" data-crk-accordion-icon>{% if section.settings.provenance_open %}−{% else %}+{% endif %}</span>
              </button>
            </h2>
            <div class="crk-section-body" id="crk-provenance-body"{% unless section.settings.provenance_open %} hidden{% endunless %}>
              <div class="crk-body">{{ product.description }}</div>
            </div>
          </section>
        {%- endif -%}

        {%- if has_measurements -%}
          <section class="crk-section" id="crk-measurements">
            <h2 class="crk-display crk-h" style="margin: 0;">
              <button type="button" class="crk-section-head" data-crk-accordion aria-expanded="{% if section.settings.measure_open %}true{% else %}false{% endif %}" aria-controls="crk-measurements-body">
                <span class="crk-display crk-h">{{ section.settings.measure_heading }}</span>
                <span class="crk-display crk-h" aria-hidden="true" data-crk-accordion-icon>{% if section.settings.measure_open %}−{% else %}+{% endif %}</span>
              </button>
            </h2>
            <div class="crk-section-body" id="crk-measurements-body"{% unless section.settings.measure_open %} hidden{% endunless %}>
              <div class="crk-units" role="group" aria-label="{{ section.settings.units_label | escape }}">
                <button type="button" class="crk-unit" data-crk-unit="cm" data-selected="true" aria-pressed="true">{{ section.settings.unit_cm }}</button>
                <button type="button" class="crk-unit" data-crk-unit="in" data-selected="false" aria-pressed="false">{{ section.settings.unit_in }}</button>
              </div>
              <table class="crk-table">
                <caption data-crk-measure-caption data-cm="{{ section.settings.measure_caption_cm | escape }}" data-in="{{ section.settings.measure_caption_in | escape }}">
                  {{ section.settings.measure_caption_cm }}
                </caption>
                <thead>
                  <tr>
                    {%- for pair in rows.first -%}
                      <th scope="col">{{ pair[0] }}</th>
                    {%- endfor -%}
                  </tr>
                </thead>
                <tbody>
                  {%- for row in rows -%}
                    <tr data-crk-measure-row="{{ row.size | escape }}" data-active="false">
                      {%- for pair in row -%}
                        {%- if forloop.first -%}
                          <th scope="row">{{ pair[1] }}</th>
                        {%- else -%}
                          <td data-cm="{{ pair[1] | escape }}">{{ pair[1] }}</td>
                        {%- endif -%}
                      {%- endfor -%}
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          </section>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <section class="crk-section" id="crk-custody">
            <h2 class="crk-display crk-h" style="margin: 0;">
              <button type="button" class="crk-section-head" data-crk-accordion aria-expanded="{% if section.settings.custody_open %}true{% else %}false{% endif %}" aria-controls="crk-custody-body">
                <span class="crk-display crk-h">{{ section.settings.custody_heading }}</span>
                <span class="crk-display crk-h" aria-hidden="true" data-crk-accordion-icon>{% if section.settings.custody_open %}−{% else %}+{% endif %}</span>
              </button>
            </h2>
            <div class="crk-section-body" id="crk-custody-body"{% unless section.settings.custody_open %} hidden{% endunless %}>
              <ol class="crk-custody">
                {%- for block in section.blocks -%}
                  {%- if block.type != 'custody_step' -%}{%- continue -%}{%- endif -%}
                  <li {{ block.shopify_attributes }}>
                    <span class="crk-label">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }} {{ block.settings.label }}</span>
                    <p class="crk-body">{{ block.settings.body }}</p>
                  </li>
                {%- endfor -%}
              </ol>
            </div>
          </section>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- filed under the same case ---------- {%- endcomment -%}
      {%- liquid
        assign related = ''
        assign related_n = 0
        for p in crk_col.products
          if p.id != product.id and p.type == product.type and related_n < 4
            assign related = related | append: p.handle | append: '|'
            assign related_n = related_n | plus: 1
          endif
        endfor
      -%}
      {%- if related_n >= 2 -%}
        <section>
          <h2 class="crk-display crk-h">{{ section.settings.related_heading }}</h2>
          <div class="crk-related">
            {%- assign handles = related | split: '|' -%}
            {%- for h in handles -%}
              {%- if h != blank -%}
                {%- assign rp = all_products[h] -%}
                {%- if rp.id -%}
                  <a href="{{ rp.url }}" class="crk-related-item">
                    <span class="crk-tray crk-related-tray">
                      {{ rp.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: rp.title }}
                    </span>
                    <span class="crk-data">{% render 'crooks-title', product: rp %}</span>
                    <span class="crk-display" style="font-size: 18px;">{{ rp.price | money }}</span>
                    {%- unless rp.available -%}
                      <span class="crk-related-soldout">{{ section.settings.label_sold }}</span>
                    {%- endunless -%}
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---------- sticky bar: mobile only, one instance ---------- {%- endcomment -%}
  {%- if product.available -%}
    <div class="crk-sticky-spacer" aria-hidden="true" hidden data-crk-sticky-spacer></div>
    <div class="crk-stickybar" data-crk-buybar hidden>
      <div style="min-width: 0; flex: 1;">
        <div class="crk-display" style="font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          {% render 'crooks-title', product: product %}
        </div>
        <div class="crk-data crk-dim" data-crk-sticky-meta>{{ crk_var.price | money }}</div>
      </div>
      <button type="button" class="crk-btn">{{ section.settings.label_add }}</button>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Crooks — Product Record",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection for product numbering, related items and the back link" },
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "← Catalogue" },
    { "type": "text", "id": "exhibit_word", "label": "Product word", "default": "PRODUCT" },
    { "type": "text", "id": "case_word", "label": "Case word", "default": "CASE" },
    { "type": "checkbox", "id": "show_texture", "label": "Show scanline texture", "default": true },
    { "type": "header", "content": "Gallery" },
    { "type": "text", "id": "photo_label", "label": "Photo counter", "info": "Use [i] and [n].", "default": "Photo [i] of [n]" },
    { "type": "text", "id": "gallery_label", "label": "Gallery group label (screen readers)", "default": "Evidence photographs" },
    { "type": "header", "content": "Buying" },
    { "type": "text", "id": "buy_label", "label": "Buy section label", "default": "Release request" },
    { "type": "text", "id": "size_group_label", "label": "Size group label (screen readers)", "default": "Select a size" },
    { "type": "text", "id": "label_add", "label": "Add to bag", "default": "Add to bag" },
    { "type": "text", "id": "label_select", "label": "No size chosen", "default": "Select a size" },
    { "type": "text", "id": "label_sold", "label": "Sold out", "default": "SOLD OUT" },
    { "type": "text", "id": "label_in_stock", "label": "In stock line", "default": "IN STOCK" },
    { "type": "text", "id": "label_low", "label": "Low stock line", "info": "Use [n] and [size].", "default": "[n] LEFT IN SIZE [size]" },
    { "type": "text", "id": "label_sold_size", "label": "Sold out size line", "info": "Use [size].", "default": "SIZE [size] IS SOLD OUT" },
    { "type": "range", "id": "low_stock_threshold", "label": "Low stock threshold", "min": 1, "max": 10, "step": 1, "default": 3 },
    { "type": "text", "id": "size_guide_label", "label": "Size guide button", "default": "Size guide" },
    { "type": "text", "id": "sr_sold_out", "label": "\"Sold out\" (screen readers)", "default": "sold out" },
    { "type": "text", "id": "sr_left", "label": "\"left\" (screen readers)", "default": "left" },
    { "type": "text", "id": "nojs_note", "label": "No-JavaScript note", "default": "CHOOSE A SIZE:" },
    { "type": "header", "content": "Delivery" },
    { "type": "text", "id": "in_stock_text", "label": "In-stock delivery line", "default": "In stock · Ships within 24 hours" },
    { "type": "text", "id": "made_to_order_text", "label": "Made-to-order delivery line", "default": "Made to order · Ships in 9–16 days" },
    { "type": "text", "id": "made_to_order_tag", "label": "Made-to-order tag", "default": "made-to-order" },
    { "type": "header", "content": "Sold out" },
    { "type": "text", "id": "released_text", "label": "Released text", "default": "RELEASED — NO LONGER IN CUSTODY" },
    { "type": "text", "id": "notify_placeholder", "label": "Notify placeholder", "default": "email address" },
    { "type": "text", "id": "notify_button", "label": "Notify button", "default": "Notify me" },
    { "type": "text", "id": "notify_subject", "label": "Notify email subject", "default": "Restock request" },
