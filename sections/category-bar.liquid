{%- comment -%}
  Persistent horizontal category chip bar for collection pages.
  Server-rendered (no layout shift), sticky under the header. The chip for the
  collection currently being viewed is filled ink/bone; the rest are outlined.
{%- endcomment -%}

{%- liquid
  assign handles = section.settings.handles | default: 'frontpage,tees,denim,sweats,accessories' | split: ','
  assign labels = section.settings.labels | default: 'Shop All,Tees,Denim,Sweats,Accessories' | split: ','
-%}

<category-bar
  class="category-bar color-{{ section.settings.color_scheme }}{% unless section.settings.sticky %} category-bar--static{% endunless %}"
>
  <nav class="category-bar__scroll" aria-label="{{ 'accessibility.collection_links' | t | default: 'Categories' }}">
    {%- for handle in handles -%}
      {%- assign handle = handle | strip -%}
      {%- assign chip = collections[handle] -%}
      {%- if chip != empty -%}
        {%- assign is_active = false -%}
        {%- if collection.handle == handle -%}
          {%- assign is_active = true -%}
        {%- endif -%}
        <a
          href="{{ chip.url }}"
          class="category-chip{% if is_active %} category-chip--active{% endif %}"
          {% if is_active %}aria-current="page"{% endif %}
        >
          {{- labels[forloop.index0] | strip | default: chip.title -}}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
</category-bar>

{% stylesheet %}
  .category-bar {
    --category-bar-inline: var(--page-margin, 16px);

    position: sticky;
    top: var(--header-height, 60px);
    z-index: 20;
    background-color: var(--color-background);
    border-block-end: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.12));
  }

  .category-bar--static {
    position: static;
  }

  .category-bar__scroll {
    display: flex;
    gap: 8px;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-block: 10px;
    padding-inline: var(--category-bar-inline);
    scroll-padding-inline: var(--category-bar-inline);
  }

  .category-bar__scroll::-webkit-scrollbar {
    display: none;
  }

  .category-chip {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 18px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: 999px;
    background-color: transparent;
    color: var(--color-foreground);
    font-family: var(--font-crx-mono, var(--font-body--family));
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .category-chip:hover {
    border-color: var(--color-foreground);
  }

  .category-chip--active {
    background-color: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-chip {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category bar",
  "tag": "section",
  "class": "category-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick under header on scroll",
      "default": true
    },
    {
      "type": "text",
      "id": "handles",
      "label": "Collection handles (comma-separated)",
      "info": "Order of the chips. Uses collection handles.",
      "default": "frontpage,tees,denim,sweats,accessories"
    },
    {
      "type": "text",
      "id": "labels",
      "label": "Chip labels (comma-separated)",
      "info": "Must line up with the handles above.",
      "default": "Shop All,Tees,Denim,Sweats,Accessories"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Category bar",
      "category": "Storefront"
    }
  ]
}
{% endschema %}
