{% comment %}
  ============================================================================
  CROOKSLDN — ORDER CONFIRMATION / RELEASE NOTICE
  ============================================================================
  Shopify notification template. Paste into:
    Settings -> Notifications -> Order confirmation

  Restyled from Shopify's default order confirmation. All Liquid logic from the
  original is preserved. See emails/NOTES.md for the full inventory.

  Blocks are delimited with Liquid comment banners (BLOCK: ...) so the HEADER,
  CHAIN OF CUSTODY and FOOTER can be lifted wholesale into the shipping
  confirmation and shipping update templates.

  Palette (inline literals only, no CSS variables):
    Ground   #0B0A0E   Panel  #0E0C13   Hairline #3A2F4A
    Purple   #542578   Accent #A77AC7   Text     #DDD7C9
    Dim      #8A8377   Red    #C4433F
  ============================================================================
{% endcomment %}

{% comment %} ---------- SETUP: delivery agreement analysis (from original) ---------- {% endcomment %}
{% assign delivery_method_types = delivery_agreements | map: 'delivery_method_type' | uniq %}
{% assign has_split_cart = false %}
{% assign non_none_count = 0 %}
{% for type in delivery_method_types %}
  {% unless type == 'none' %}
    {% assign non_none_count = non_none_count | plus: 1 %}
  {% endunless %}
{% endfor %}
{% if non_none_count > 1 %}
  {% assign has_split_cart = true %}
{% endif %}

{% assign non_none_agreements_count = 0 %}
{% for agreement in delivery_agreements %}
  {% unless agreement.delivery_method_type == 'none' %}
    {% assign non_none_agreements_count = non_none_agreements_count | plus: 1 %}
  {% endunless %}
{% endfor %}

{% comment %} ---------- SETUP: status copy (from original, reworded per brief) ---------- {% endcomment %}
{% capture email_title %}Order confirmed{% endcapture %}

{% capture email_body %}
  {% if has_pending_payment %}
    {% if buyer_action_required %}
      <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">You will get a confirmation email after completing your payment.</p>
    {% else %}
      <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">Your payment is being processed. You will get an email when your order is confirmed.</p>
    {% endif %}
  {% elsif payment_charged_on_fulfillment %}
    <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">{{ customer.first_name }}, your order has been logged. Your payment method will be charged when your order is ready to be fulfilled. We will notify you when it is on its way.</p>
  {% else %}
    {% if requires_shipping %}
      {% if has_split_cart %}
        {% case split_cart_delivery_method %}
          {% when 'pick-up' %}
            <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">Your order has been logged. You will receive an email when your order is ready for pickup.</p>
          {% when 'local' %}
            <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">{{ customer.first_name }}, your order has been logged. We are getting it ready for delivery.</p>
          {% when 'shipping' %}
            <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">Your order has been logged. Dispatch within 24 hours, Monday to Saturday. We will notify you when it has been sent.</p>
          {% else %}
            <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">Your order has been logged. Dispatch within 24 hours, Monday to Saturday. We will notify you when it has been sent.</p>
        {% endcase %}
      {% else %}
        {% case delivery_method %}
          {% when 'pick-up' %}
            <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">Your order has been logged. You will receive an email when your order is ready for pickup.</p>
          {% when 'local' %}
            <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">{{ customer.first_name }}, your order has been logged. We are getting it ready for delivery.</p>
          {% else %}
            <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">Your order has been logged. Dispatch within 24 hours, Monday to Saturday. We will notify you when it has been sent.</p>
        {% endcase %}
      {% endif %}

      {% if delivery_instructions != blank %}
        <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:13px;line-height:20px;color:#8A8377;">
          <span style="color:#A77AC7;text-transform:uppercase;letter-spacing:0.16em;font-size:11px;">Delivery information</span><br />
          <span style="color:#DDD7C9;">{{ delivery_instructions }}</span>
        </p>
      {% endif %}

      {% unless delivery_method_types.size > 1 %}
        {% if consolidated_estimated_delivery_time %}
          {% if non_none_agreements_count > 1 %}
            <p style="margin:0 0 4px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:11px;line-height:16px;letter-spacing:0.16em;text-transform:uppercase;color:#A77AC7;">Estimated delivery</p>
            <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">{{ consolidated_estimated_delivery_time }}</p>
          {% else %}
            <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:13px;line-height:20px;color:#8A8377;">
              <span style="color:#A77AC7;text-transform:uppercase;letter-spacing:0.16em;font-size:11px;">Estimated delivery</span>
              <span style="color:#DDD7C9;">{{ consolidated_estimated_delivery_time }}</span>
            </p>
          {% endif %}
        {% endif %}
      {% endunless %}
    {% endif %}
  {% endif %}

  {% assign gift_card_line_items = line_items | where: "gift_card" %}
  {% assign found_gift_card_with_recipient_email = false %}
  {% for line_item in gift_card_line_items %}
    {% if line_item.properties["__shopify_send_gift_card_to_recipient"] and line_item.properties["Recipient email"] %}
      {% assign found_gift_card_with_recipient_email = true %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if found_gift_card_with_recipient_email %}
    <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">Your gift card recipient will receive an email with their gift card code.</p>
  {% elsif gift_card_line_items.first %}
    <p style="margin:0 0 12px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;">You will receive separate emails for any gift cards.</p>
  {% endif %}
{% endcapture %}

{% comment %} Exhibit counter for line item numbering {% endcomment %}
{% assign exh = 0 %}

<!DOCTYPE html>
<html lang="en" style="color-scheme:dark light;supported-color-schemes:dark light;">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark light" />
  <meta name="supported-color-schemes" content="dark light" />
  <meta name="x-apple-disable-message-reformatting" />
  <title>{{ email_title }} — {{ order_name }}</title>
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css" />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap" rel="stylesheet" type="text/css" />
  <style type="text/css">
    :root {
      color-scheme: dark light;
      supported-color-schemes: dark light;
    }

    body,
    table,
    td,
    a {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    table {
      border-collapse: collapse;
    }

    img {
      border: 0;
      outline: none;
      text-decoration: none;
      -ms-interpolation-mode: bicubic;
    }

    a {
      color: #A77AC7;
    }

    a:hover,
    a:active,
    a:visited {
      color: #A77AC7;
    }

    .crx-btn a {
      color: #DDD7C9 !important;
      text-decoration: none;
    }

    /* Outlook.com / Gmail sometimes force their own link colour on plain text */
    .crx-unstyle a {
      color: #DDD7C9 !important;
      text-decoration: none;
    }

    @media only screen and (max-width: 620px) {
      .crx-wrap {
        width: 100% !important;
      }

      .crx-pad {
        padding-left: 16px !important;
        padding-right: 16px !important;
      }

      .crx-stack {
        display: block !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }

      .crx-stack-gap {
        padding-bottom: 20px !important;
      }

      .crx-order-no {
        font-size: 26px !important;
      }
    }
  </style>
</head>

<body style="margin:0;padding:0;width:100%;background-color:#0B0A0E;color:#DDD7C9;font-family:'IBM Plex Mono','Courier New',Courier,monospace;" bgcolor="#0B0A0E">

  {% comment %} ================= BLOCK: PREHEADER ================= {% endcomment %}
  <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;color:#0B0A0E;">
    Order {{ order_name }} confirmed. Dispatch within 24 hours.
  </div>
  <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;color:#0B0A0E;">
    &#8199;&#847;&zwnj;&nbsp;&#8199;&#847;&zwnj;&nbsp;&#8199;&#847;&zwnj;&nbsp;&#8199;&#847;&zwnj;&nbsp;&#8199;&#847;&zwnj;&nbsp;&#8199;&#847;&zwnj;&nbsp;&#8199;&#847;&zwnj;&nbsp;&#8199;&#847;&zwnj;&nbsp;
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0B0A0E" style="width:100%;background-color:#0B0A0E;">
    <tr>
      <td align="center" bgcolor="#0B0A0E" style="background-color:#0B0A0E;padding:0;">

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="crx-wrap" style="width:600px;max-width:600px;">

          {% comment %} ================= BLOCK: HEADER (reusable) ================= {% endcomment %}
          <tr>
            <td class="crx-pad" bgcolor="#0B0A0E" style="background-color:#0B0A0E;padding:32px 24px 24px 24px;border-bottom:1px solid #3A2F4A;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                <tr>
                  <td align="left" valign="top" style="padding:0;">
                    {%- if shop.email_logo_url %}
                      <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width }}" style="display:block;border:0;max-width:100%;height:auto;" />
                    {%- else %}
                      <div style="font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:22px;line-height:26px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;color:#DDD7C9;">
                        <a href="{{ shop.url }}" style="color:#DDD7C9;text-decoration:none;">{{ shop.name }}</a>
                      </div>
                    {%- endif %}
                    <div style="padding-top:8px;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:11px;line-height:16px;letter-spacing:0.2em;text-transform:uppercase;color:#A77AC7;">
                      Property store &mdash; Release notice
                    </div>
                  </td>
                  <td align="right" valign="top" style="padding:0;">
                    <div style="font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:11px;line-height:16px;letter-spacing:0.16em;text-transform:uppercase;color:#8A8377;">
                      Order {{ order_name }}
                    </div>
                    {%- if po_number %}
                      <div style="padding-top:4px;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:11px;line-height:16px;letter-spacing:0.16em;text-transform:uppercase;color:#8A8377;">
                        PO number #{{ po_number }}
                      </div>
                    {%- endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {% comment %} ================= BLOCK: CONFIRMATION ================= {% endcomment %}
          <tr>
            <td class="crx-pad" bgcolor="#0B0A0E" style="background-color:#0B0A0E;padding:32px 24px 8px 24px;">
              <div style="font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:16px;letter-spacing:0.24em;text-transform:uppercase;color:#A77AC7;padding-bottom:16px;">
                {{ email_title }}
              </div>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0E0C13" style="width:100%;background-color:#0E0C13;border:1px solid #3A2F4A;">
                <tr>
                  <td bgcolor="#0E0C13" style="background-color:#0E0C13;padding:20px 24px 20px 24px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                      <tr>
                        <td align="left" valign="top" style="padding:0;">
                          <div style="font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:11px;line-height:16px;letter-spacing:0.2em;text-transform:uppercase;color:#8A8377;">Order</div>
                          <div class="crx-order-no" style="padding-top:4px;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:32px;line-height:38px;font-weight:600;letter-spacing:0.04em;color:#DDD7C9;">{{ order_name }}</div>
                        </td>
                        <td align="right" valign="bottom" style="padding:0;">
                          <div style="font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:11px;line-height:16px;letter-spacing:0.2em;text-transform:uppercase;color:#8A8377;">Date</div>
                          {%- assign order_date = order.created_at | default: created_at -%}
                          <div style="padding-top:4px;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:13px;line-height:20px;color:#DDD7C9;">{{ order_date | date: "%d %b %Y" }}</div>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td class="crx-pad" bgcolor="#0B0A0E" style="background-color:#0B0A0E;padding:20px 24px 0 24px;">
              {{ email_body }}
            </td>
          </tr>

          {% comment %} ---------- Pending payment instructions (preserved) ---------- {% endcomment %}
          {% assign transaction_count = transactions | size %}
          {% if transaction_count > 0 %}
            {% for transaction in transactions %}
              {% if transaction.show_buyer_pending_payment_instructions? %}
                <tr>
                  <td class="crx-pad" bgcolor="#0B0A0E" style="background-color:#0B0A0E;padding:8px 24px 0 24px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0E0C13" style="width:100%;background-color:#0E0C13;border:1px solid #3A2F4A;">
                      <tr>
                        <td bgcolor="#0E0C13" style="background-color:#0E0C13;padding:20px 24px;">
                          <div style="font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:11px;line-height:16px;letter-spacing:0.2em;text-transform:uppercase;color:#C4433F;padding-bottom:12px;">Payment required</div>
                          <div style="font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:22px;color:#DDD7C9;padding-bottom:16px;">{{ transaction.buyer_pending_payment_notice }}</div>
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                            <tr>
                              {% for instruction in transaction.buyer_pending_payment_instructions %}
                                <td align="left" valign="top" style="padding:0 12px 6px 0;border-bottom:1px solid #3A2F4A;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:11px;line-height:16px;letter-spacing:0.16em;text-transform:uppercase;color:#8A8377;">{{ instruction.header }}</td>
                              {% endfor %}
                              <td align="right" valign="top" style="padding:0 0 6px 0;border-bottom:1px solid #3A2F4A;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:11px;line-height:16px;letter-spacing:0.16em;text-transform:uppercase;color:#8A8377;">Amount</td>
                            </tr>
                            <tr>
                              {% for instruction in transaction.buyer_pending_payment_instructions %}
                                <td align="left" valign="top" style="padding:10px 12px 0 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:13px;line-height:20px;color:#DDD7C9;">{{ instruction.value }}</td>
                              {% endfor %}
                              <td align="right" valign="top" style="padding:10px 0 0 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:13px;line-height:20px;color:#DDD7C9;">{{ transaction.amount | money }}</td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              {% endif %}
            {% endfor %}
          {% endif %}

          {% comment %} ================= BLOCK: PRIMARY ACTION ================= {% endcomment %}
          <tr>
            <td class="crx-pad" bgcolor="#0B0A0E" style="background-color:#0B0A0E;padding:20px 24px 32px 24px;">
              {% if order_status_url %}
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;">
                  <tr>
                    <td class="crx-btn" bgcolor="#542578" align="center" style="background-color:#542578;border:1px solid #542578;padding:14px 28px;">
                      <a href="{{ order_status_url }}" style="display:inline-block;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:16px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:#DDD7C9;text-decoration:none;">View order status</a>
                    </td>
                  </tr>
                </table>

                {% if shop_app_tracking_url and shop_app_tracking_button_variant_key %}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;margin-top:12px;">
                    <tr>
                      <td bgcolor="#0E0C13" align="center" style="background-color:#0E0C13;border:1px solid #3A2F4A;padding:14px 28px;">
                        <a href="{{ shop_app_tracking_url }}" style="display:inline-block;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:16px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:#DDD7C9;text-decoration:none;">
                          {% if shop_app_tracking_button_variant_key == "track_with_shop" %}
                            Track order with Shop
                          {% else %}
                            Download to track with Shop
                          {% endif %}
                        </a>
                      </td>
                    </tr>
                  </table>
                {% endif %}

                {% if shop.url %}
                  <div style="padding-top:16px;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:18px;color:#8A8377;">
                    or <a href="{{ shop.url }}" style="color:#A77AC7;text-decoration:underline;">visit our store</a>
                  </div>
                {% endif %}
              {% else %}
                {% if shop.url %}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;">
                    <tr>
                      <td class="crx-btn" bgcolor="#542578" align="center" style="background-color:#542578;border:1px solid #542578;padding:14px 28px;">
                        <a href="{{ shop.url }}" style="display:inline-block;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:16px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:#DDD7C9;text-decoration:none;">Visit our store</a>
                      </td>
                    </tr>
                  </table>
                {% endif %}
              {% endif %}
            </td>
          </tr>

          {% comment %} ================= BLOCK: ORDER SUMMARY / EXHIBITS ================= {% endcomment %}
          <tr>
            <td class="crx-pad" bgcolor="#0B0A0E" style="background-color:#0B0A0E;padding:0 24px 0 24px;">
              <div style="font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:16px;letter-spacing:0.24em;text-transform:uppercase;color:#A77AC7;padding-bottom:8px;border-top:1px solid #3A2F4A;padding-top:28px;">
                Order summary
              </div>
            </td>
          </tr>

          <tr>
            <td class="crx-pad" bgcolor="#0B0A0E" style="background-color:#0B0A0E;padding:0 24px 0 24px;">

            {% if delivery_method_types.size > 1 %}
              {% comment %} ---------- SPLIT CART: items grouped by delivery agreement ---------- {% endcomment %}

              {% comment %} Legacy lines that carry no delivery agreement {% endcomment %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                {% for line in subtotal_line_items %}
                  {% unless line.delivery_agreement %}
                    {% if line.groups.size == 0 %}
                      {% assign legacy_separator = true %}
                      {%- unless line.nested_line_child? -%}
                        {%- if line.presentment_title -%}
                          {%- assign line_title = line.presentment_title -%}
                        {%- elsif line.title -%}
                          {%- assign line_title = line.title -%}
                        {%- else -%}
                          {%- assign line_title = line.product.title -%}
                        {%- endif -%}
                        {%- assign line_display = line.quantity -%}
                        {%- assign exh = exh | plus: 1 -%}
                        {%- assign exh_num = exh | prepend: '0' | slice: -2, 2 -%}
                        <tr>
                          <td style="padding:0;border-top:1px solid #3A2F4A;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                              <tr>
                                <td width="76" valign="top" style="width:76px;padding:20px 16px 20px 0;">
                                  {%- if line.image -%}
                                    <img src="{{ line | img_url: 'compact_cropped' }}" width="60" height="60" alt="{{ line_title }}" style="display:block;width:60px;height:60px;border:1px solid #3A2F4A;" />
                                  {%- else -%}
                                    <img src="{{ 'notifications/no-image.png' | shopify_asset_url }}" width="60" height="60" alt="" style="display:block;width:60px;height:60px;border:1px solid #3A2F4A;" />
                                  {%- endif -%}
                                </td>
                                <td valign="top" style="padding:20px 12px 20px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;">
                                  <div style="font-size:10px;line-height:14px;letter-spacing:0.2em;text-transform:uppercase;color:#8A8377;">Exh {{ exh_num }}</div>
                                  <div style="padding-top:4px;font-size:14px;line-height:20px;color:#DDD7C9;">{{ line_title }}</div>
                                  {%- if line.variant.title != 'Default Title' -%}
                                    <div style="padding-top:2px;font-size:12px;line-height:18px;color:#8A8377;">{{ line.variant.title }}</div>
                                  {%- endif -%}
                                  {%- for group in line.groups -%}
                                    {%- if group.deliverable? -%}
                                      <div style="padding-top:2px;font-size:12px;line-height:18px;color:#8A8377;">For: {{ group.display_title }}</div>
                                    {%- else -%}
                                      <div style="padding-top:2px;font-size:12px;line-height:18px;color:#8A8377;">Part of: {{ group.display_title }}</div>
                                    {%- endif -%}
                                  {%- endfor -%}
                                  {%- if line.gift_card and line.properties["__shopify_send_gift_card_to_recipient"] -%}
                                    {%- for property in line.properties -%}
                                      {%- assign property_first_char = property.first | slice: 0 -%}
                                      {%- if property.last != blank and property_first_char != '_' -%}
                                        <div style="padding-top:2px;font-size:12px;line-height:18px;color:#8A8377;">
                                          {{ property.first }}:
                                          {%- if property.last contains '/uploads/' -%}
                                            <a href="{{ property.last }}" target="_blank" style="color:#A77AC7;text-decoration:underline;">{{ property.last | split: '/' | last }}</a>
                                          {%- else -%}
                                            <span style="color:#DDD7C9;">{{ property.last }}</span>
                                          {%- endif -%}
                                        </div>
                                      {%- endif -%}
                                    {%- endfor -%}
