                            <td align="right" style="padding:0 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:18px;color:#A77AC7;">{{ total_discounts | money }}</td>
                          </tr>
                        {% endif %}
                      {% else %}
                        <tr>
                          <td align="left" style="padding:16px 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:18px;letter-spacing:0.2em;text-transform:uppercase;color:#A77AC7;">Total</td>
                          <td align="right" style="padding:16px 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:18px;line-height:24px;font-weight:600;color:#DDD7C9;">{{ total_price | money_with_currency }}</td>
                        </tr>
                        {% if total_discounts > 0 %}
                          <tr>
                            <td align="left" style="padding:0 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:11px;line-height:16px;letter-spacing:0.12em;text-transform:uppercase;color:#A77AC7;">You saved</td>
                            <td align="right" style="padding:0 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:18px;color:#A77AC7;">{{ total_discounts | money }}</td>
                          </tr>
                        {% endif %}
                        {% if net_transaction_amount_rounding != 0 %}
                          <tr><td colspan="2" style="padding:0;height:1px;line-height:1px;font-size:0;background-color:#3A2F4A;">&nbsp;</td></tr>
                          <tr>
                            <td align="left" style="padding:8px 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:18px;color:#8A8377;">Cash rounding</td>
                            <td align="right" style="padding:8px 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:18px;color:#DDD7C9;">{% if net_transaction_amount_rounding < 0 %}-{% endif %} {{ net_transaction_amount_rounding | abs | money }}</td>
                          </tr>
                          {% if financial_status == 'paid' %}
