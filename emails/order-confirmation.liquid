                          {{ delivery_agreement.presentment_title }}{% if delivery_agreement.estimated_delivery_date %} &middot; {{ delivery_agreement.estimated_delivery_date }}{% endif %}
                        </div>
                      {% endif %}
                    {% endif %}
                  {% endif %}

                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
