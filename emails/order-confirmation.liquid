                        {% when "alipay" %}
                          <div style="padding-top:12px;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:18px;color:#8A8377;">View the CNY total in Alipay</div>
                      {% endcase %}
                    {% endunless %}

                  </td>
                </tr>
              </table>
            </td>
          </tr>

