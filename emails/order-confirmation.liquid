                    {% for line_item_group in delivery_agreement.line_item_groups %}
                      {% comment %}
                        Original rendered the group block in two places (deliverable? == false, and
                        deliverable? whose parent belongs to this agreement). Same markup, same data,
                        so the condition is hoisted into render_group and the block appears once.
                      {% endcomment %}
                      {% assign render_group = false %}
                      {% if line_item_group.deliverable? == false %}
                        {% assign render_group = true %}
                      {% elsif delivery_agreement == line_item_group.parent_sales_line_item.delivery_agreement %}
