                                          {%- endif -%}
                                        {%- else -%}
                                          Free
                                        {%- endif -%}
                                      </div>
                                    </td>
                                  </tr>
                                  {%- if component.nested_line_parent? -%}
                                    {%- for child_line in component.nested_lines -%}
