                          <tr>
                            <td align="left" style="padding:8px 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:18px;color:#8A8377;">Cash rounding</td>
                            <td align="right" style="padding:8px 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:18px;color:#DDD7C9;">{% if net_transaction_amount_rounding < 0 %}-{% endif %} {{ net_transaction_amount_rounding | abs | money }}</td>
                          </tr>
                          <tr><td colspan="2" style="padding:0;height:1px;line-height:1px;font-size:0;background-color:#3A2F4A;">&nbsp;</td></tr>
                        {% endif %}

                        <tr>
                          <td align="left" style="padding:16px 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:12px;line-height:18px;letter-spacing:0.2em;text-transform:uppercase;color:#A77AC7;">Total paid today</td>
                          <td align="right" style="padding:16px 0 5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:18px;line-height:24px;font-weight:600;color:#DDD7C9;">{{ transaction_amount | plus: net_transaction_amount_rounding | money_with_currency }}</td>
                        </tr>

                        {% assign next_amount_due = total_price %}
                        {% if next_payment %}
                          {% assign next_amount_due = next_payment.amount_due %}
                        {% elsif total_outstanding > 0 %}
                          {% assign next_amount_due = total_outstanding %}
                        {% endif %}

                        {% if payment_terms.type == 'receipt' %}
                          <tr>
                            <td align="left" style="padding:5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:13px;line-height:20px;color:#8A8377;">Total due on receipt</td>
                            <td align="right" style="padding:5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:20px;color:#DDD7C9;">{{ next_amount_due | money_with_currency }}</td>
                          </tr>
                        {% elsif payment_terms.type == 'fulfillment' %}
                          <tr>
                            <td align="left" style="padding:5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:13px;line-height:20px;color:#8A8377;">Total due on fulfillment</td>
                            <td align="right" style="padding:5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:20px;color:#DDD7C9;">{{ next_amount_due | money_with_currency }}</td>
                          </tr>
                        {% else %}
                          <tr>
                            <td align="left" style="padding:5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:13px;line-height:20px;color:#8A8377;">Total due {{ due_at_date }}</td>
                            <td align="right" style="padding:5px 0;font-family:'IBM Plex Mono','Courier New',Courier,monospace;font-size:14px;line-height:20px;color:#DDD7C9;">{{ next_amount_due | money_with_currency }}</td>
                          </tr>
                        {% endif %}

                        {% if total_discounts > 0 and net_transaction_amount_rounding == 0 %}
