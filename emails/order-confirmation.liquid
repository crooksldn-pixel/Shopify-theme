                      <div style="font-size:11px;line-height:16px;letter-spacing:0.16em;text-transform:uppercase;color:#8A8377;padding-bottom:6px;">Billing address</div>
                      <div class="crx-unstyle">{{ billing_address | format_address }}</div>
