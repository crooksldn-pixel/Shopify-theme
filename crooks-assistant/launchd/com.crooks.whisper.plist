<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  whisper-server as a separate long-lived process, so the model stays resident in memory.
  Loading the model per request costs seconds and makes the whole product feel broken.

  Install:  cp launchd/com.crooks.whisper.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/com.crooks.whisper.plist
  Replace USERNAME with your short username.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.crooks.whisper</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/crooks-assistant/.venv/bin/python</string>
    <string>/Users/USERNAME/crooks-assistant/scripts/whisper_server.py</string>
  </array>

  <key>WorkingDirectory</key><string>/Users/USERNAME/crooks-assistant</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/USERNAME</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
    <key>Crashed</key><true/>
  </dict>
  <key>ThrottleInterval</key><integer>10</integer>

  <key>StandardOutPath</key><string>/Users/USERNAME/crooks-assistant/logs/whisper.out.log</string>
  <key>StandardErrorPath</key><string>/Users/USERNAME/crooks-assistant/logs/whisper.err.log</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
