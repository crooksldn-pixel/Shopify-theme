<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. `make install` fills the placeholders and loads it; do not copy by hand.

  whisper-server as a separate long-lived process, so the model stays resident in memory.
  Loading the model per request costs seconds and makes the whole product feel broken.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.crooks.whisper</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{PYTHON}}</string>
    <string>{{ROOT}}/scripts/whisper_server.py</string>
  </array>

  <key>WorkingDirectory</key><string>{{ROOT}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{{PATH}}</string>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
    <key>Crashed</key><true/>
  </dict>
  <key>ThrottleInterval</key><integer>10</integer>

  <key>StandardOutPath</key><string>{{LOGS}}/whisper.out.log</string>
  <key>StandardErrorPath</key><string>{{LOGS}}/whisper.err.log</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
