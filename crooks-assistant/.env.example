# Non-secret configuration only. Secrets live in the macOS Keychain — see scripts/set_secrets.py
CROOKS_SHOPIFY_SHOP_DOMAIN=5wn03t-nm.myshopify.com
CROOKS_SHOPIFY_API_VERSION=2025-07
CROOKS_SHOPIFY_AUTH_MODE=client_credentials
# Speech: ElevenLabs Scribe first, local whisper.cpp as the automatic fallback.
# Set CROOKS_STT_PRIMARY=whisper to run entirely on this Mac.
CROOKS_STT_PRIMARY=scribe
CROOKS_SCRIBE_MODEL=scribe_v2
CROOKS_SCRIBE_LANGUAGE=eng
CROOKS_SCRIBE_TIMEOUT_S=20
CROOKS_SCRIBE_KEYTERMS=true
# The assistant's voice. False falls the tablet back to its own Android voice.
CROOKS_TTS_ENABLED=true
CROOKS_TTS_VOICE_ID=Q0Et7LOU7VpeoeCRQAVS
CROOKS_TTS_VOICE_NAME=Derek
CROOKS_TTS_MODEL=eleven_flash_v2_5
CROOKS_TTS_OUTPUT_FORMAT=mp3_44100_128
CROOKS_TTS_TIMEOUT_S=20
CROOKS_WHISPER_URL=http://127.0.0.1:8910
CROOKS_WHISPER_MODEL=small.en
CROOKS_CLAUDE_MODEL=sonnet
CROOKS_HOST=127.0.0.1
CROOKS_PORT=8000
CROOKS_TOOL_TIMEOUT_S=8
CROOKS_SESSION_IDLE_TIMEOUT_S=1800
CROOKS_LOG_DIR=logs
